# Central-DB connection for a consuming project. Copy to the project's .env and adjust DB_NAMESPACE.

# The default/production build accepts only Redline.
# SQLite requires a build with the explicit sqlite-parity feature for parity or migration work.
DB_BACKEND=redline

# Data source.
#   redline -> the central server:  redline://HOST:PORT
#   sqlite  -> a local file path (sqlite-parity builds only): /var/lib/<project>/state.sqlite
DB_DSN=redline://127.0.0.1:6033

# Per-project table-name prefix so every project coexists in the ONE central database.
DB_NAMESPACE=jain                  # jain_* / jekko_* / jeryu_* / scq_* / jope_*
