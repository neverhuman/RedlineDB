FUCKIT.md

# Local jeryu daemon runtime artifacts stay out of the repo, but the direct-mode
# onboarding + shadow-main (mirror-on-merge) config travels with it, exactly like
# redline-testing tracks its .jeryu/ config.
.jeryu/*
!.jeryu/repo.toml
!.jeryu/ci.toml
!.jeryu/policy.toml
!.jeryu/backup.toml
!.jeryu/local/
.jeryu/local/*
!.jeryu/local/repos/
.jeryu/local/repos/*
!.jeryu/local/repos/*.toml

# claude-code agent runtime: scheduled-tasks state + isolated worktrees
.claude/

# Local-only safety-net backups (e.g., backup of stashes during dir moves)
.scratch/

# Compiled baseline binaries in benchmark-results — these are ELF executables
# that jankurai cannot read as UTF-8 text. Store raw.jsonl/summary.json only.
benchmark-results/sqlite-parity/baselines/**/redlinedb-*
