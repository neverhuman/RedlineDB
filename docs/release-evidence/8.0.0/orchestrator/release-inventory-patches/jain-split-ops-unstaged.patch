+        command.push("--no-tags".to_owned());
+    }
+    if !options.atomicsoul {
+        command.push("--no-atomicsoul".to_owned());
+    }
+    for repo in &options.selected {
+        command.extend(["--repo".to_owned(), repo.clone()]);
+    }
+    if options.from_wave != 0 {
