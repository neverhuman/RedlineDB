+    value as usize % lane_count.max(1)
+}
+
+fn mix_u64(value: u64) -> u64 {
+    let mut x = value;
+    x ^= x >> 33;
+    x = x.wrapping_mul(0xff51afd7ed558ccd);
+    x ^= x >> 33;
+    x = x.wrapping_mul(0xc4ceb9fe1a85ec53);
+    x ^ (x >> 33)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::engine::CommitDurability;
+
+    #[test]
+    fn manifest_lists_every_gene() {
+        let genome = StageGenome::default();
+        let manifest = genome.manifest();
+        assert_eq!(manifest.gene_count, STAGE_GENE_COUNT);
+        assert_eq!(manifest.genes.len(), STAGE_GENE_COUNT);
+    }
+
+    #[test]
+    fn commit_barrier_cannot_weaken_configured_durability() {
+        let mut genome = StageGenome::default();
+        genome.runtime.commit_barrier = CommitBarrierStage::UnsafeDevOnly;
+        assert_eq!(
+            genome.commit_barrier_action(CommitDurability::Strict),
+            CommitBarrierAction::Flush
+        );
+        assert_eq!(
+            genome.commit_barrier_action(CommitDurability::Normal),
+            CommitBarrierAction::Write
+        );
+        assert_eq!(
+            genome.commit_barrier_action(CommitDurability::UnsafeDev),
+            CommitBarrierAction::None
+        );
+    }
+
+    #[test]
+    fn heap_lanes_and_reuse_are_bounded() {
+        let mut genome = StageGenome::default();
+        genome.heap.row_lane = HeapLaneStage::HashStripe;
+        genome.heap.relation_lane = HeapLaneStage::XorShift;
+        assert!(genome.heap_row_lane(RowId(99), 7) < 7);
+        assert!(genome.heap_relation_lane(RelId(99), 7) < 7);
+        assert!(!genome.heap_reusable_page(PageKind::Heap, 128, 0));
+    }
+
+    #[test]
+    fn buffer_rejects_unsafe_eviction_candidates() {
+        let genome = StageGenome::default();
+        let unsafe_dirty = FrameStageMeta {
+            pin_count: 0,
+            dirty: true,
+            usage_count: 0,
+            write_in_progress: false,
+            page_lsn: Lsn(10),
+            durable_lsn: Lsn(9),
+        };
+        assert_eq!(genome.buffer_victim_score(unsafe_dirty), None);
+
+        let safe_clean = FrameStageMeta {
+            dirty: false,
+            page_lsn: Lsn(10),
+            durable_lsn: Lsn(9),
+            ..unsafe_dirty
+        };
+        assert!(genome.buffer_victim_score(safe_clean).is_some());
+    }
+}
