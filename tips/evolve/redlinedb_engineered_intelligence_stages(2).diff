+//! Engineered-intelligence stage contracts.
+//!
+//! A stage is allowed to choose bounded policy decisions such as ordering,
+//! batching, placement, and advisory prefetch.  Stages are not allowed to own
+//! database truth: page/WAL encodings, MVCC visibility, transaction-state
+//! publication, catalog semantics, and recovery validity remain in the fixed
+//! kernel.  This module centralizes the runtime genome so benchmarking and
+//! evolution harnesses can swap safe stage genes without editing hot-path code.
+
+use crate::format::{Lsn, PageId, PageKind, RelId, RowId, UndoPtr};
+
+pub const STAGE_GENE_COUNT: usize = 14;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageGenome {
+    pub runtime: RuntimeStageGenome,
+    pub maintenance: MaintenanceStageGenome,
+    pub buffer: BufferStageGenome,
+    pub heap: HeapStageGenome,
+    pub wal: WalStageGenome,
+}
+
+impl Default for StageGenome {
+    fn default() -> Self {
+        Self {
+            runtime: RuntimeStageGenome::default(),
+            maintenance: MaintenanceStageGenome::default(),
+            buffer: BufferStageGenome::default(),
+            heap: HeapStageGenome::default(),
+            wal: WalStageGenome::default(),
+        }
+    }
+}
+
+impl StageGenome {
+    /// Normalize a genome before installing it into a live engine.
+    ///
+    /// The current enum genome has no invalid bit-patterns, so normalization is
+    /// identity.  Keeping the hook explicit gives future agent-generated gene
+    /// loaders one place to clamp unknown/serialized variants back to safe
+    /// defaults.
+    pub fn normalize(self) -> Self {
+        self
+    }
+
+    pub fn gene_count(&self) -> usize {
+        STAGE_GENE_COUNT
+    }
+
+    pub fn manifest(&self) -> StageManifest {
+        StageManifest {
+            gene_count: STAGE_GENE_COUNT,
+            genes: vec![
+                gene(
+                    "runtime.commit_barrier",
+                    self.runtime.commit_barrier.name(),
+                    "chooses the runtime durability barrier, clamped by CommitDurability",
+                ),
+                gene(
+                    "maintenance.checkpoint_batch",
+                    self.maintenance.checkpoint_batch.name(),
+                    "chooses dirty-page checkpoint batch size",
+                ),
+                gene(
+                    "buffer.victim",
+                    self.buffer.victim.name(),
+                    "scores eviction candidates after hard safety rejection",
+                ),
+                gene(
+                    "buffer.dirty_batch",
+                    self.buffer.dirty_batch.name(),
+                    "chooses dirty-page flush batch size",
+                ),
+                gene(
+                    "buffer.dirty_order",
+                    self.buffer.dirty_order.name(),
+                    "orders durable dirty pages before flushing",
+                ),
+                gene(
+                    "buffer.cold_prefetch",
+                    self.buffer.cold_prefetch.name(),
+                    "chooses whether advisory prefetch may cold-load a page",
+                ),
+                gene(
+                    "heap.row_lane",
+                    self.heap.row_lane.name(),
+                    "routes row ids to row-directory and append-lane shards",
+                ),
+                gene(
+                    "heap.relation_lane",
+                    self.heap.relation_lane.name(),
+                    "routes relation ids to relation-directory shards",
+                ),
+                gene(
+                    "heap.reusable_page",
+                    self.heap.reusable_page.name(),
+                    "chooses when reusable heap/undo pages are preferred",
+                ),
+                gene(
+                    "heap.undo_prefetch",
+                    self.heap.undo_prefetch.name(),
+                    "issues advisory undo-chain prefetch hints only",
+                ),
+                gene(
+                    "wal.write_batch",
+                    self.wal.write_batch.name(),
+                    "chooses writer-thread WAL drain size before normal writes",
+                ),
+                gene(
+                    "wal.group_delay",
+                    self.wal.group_delay.name(),
+                    "chooses group-commit delay up to configured maximum",
+                ),
+                gene(
+                    "wal.resample_flush_target",
+                    self.wal.resample_flush_target.name(),
+                    "chooses whether to widen fsync target after group window",
+                ),
+                gene(
+                    "wal.drain_batch",
+                    self.wal.drain_batch.name(),
+                    "chooses extra pre-fsync WAL drain size",
+                ),
+            ],
+        }
+    }
+
+    pub(crate) fn commit_barrier_action(
+        &self,
+        durability: crate::engine::CommitDurability,
+    ) -> CommitBarrierAction {
+        use crate::engine::CommitDurability;
+        match durability {
+            CommitDurability::Strict => CommitBarrierAction::Flush,
+            CommitDurability::Normal => match self.runtime.commit_barrier {
+                CommitBarrierStage::StrictAlways => CommitBarrierAction::Flush,
+                CommitBarrierStage::Configured
+                | CommitBarrierStage::NormalWrite
+                | CommitBarrierStage::UnsafeDevOnly => CommitBarrierAction::Write,
+            },
+            CommitDurability::UnsafeDev => match self.runtime.commit_barrier {
+                CommitBarrierStage::StrictAlways => CommitBarrierAction::Flush,
+                CommitBarrierStage::NormalWrite => CommitBarrierAction::Write,
+                CommitBarrierStage::Configured | CommitBarrierStage::UnsafeDevOnly => {
+                    CommitBarrierAction::None
+                }
+            },
+        }
+    }
+
+    pub(crate) fn checkpoint_batch_pages(&self, resident_pages: usize) -> usize {
+        let raw = match self.maintenance.checkpoint_batch {
+            CheckpointBatchStage::Default64 => 64,
+            CheckpointBatchStage::Latency32 => 32,
+            CheckpointBatchStage::Throughput256 => 256,
+            CheckpointBatchStage::ResidentAdaptive => (resident_pages / 8).clamp(16, 512),
+        };
+        raw.clamp(1, 4096)
+    }
+
+    pub(crate) fn buffer_victim_score(&self, meta: FrameStageMeta) -> Option<u32> {
+        // Hard safety rejection.  No generated stage may override this.
+        if meta.pin_count > 0 || meta.write_in_progress {
+            return None;
+        }
+        if meta.dirty && meta.page_lsn > meta.durable_lsn {
+            return None;
+        }
+        if meta.usage_count > 0 {
+            return None;
+        }
+        Some(match self.buffer.victim {
+            BufferVictimStage::Clock => {
+                if meta.dirty {
+                    10
+                } else {
+                    0
+                }
+            }
+            BufferVictimStage::CleanFirst => {
+                if meta.dirty {
+                    100
+                } else {
+                    0
+                }
+            }
+            BufferVictimStage::DirtyFirst => {
+                if meta.dirty {
+                    0
+                } else {
+                    10
+                }
+            }
+            BufferVictimStage::HotReadProtect => {
+                if meta.dirty {
+                    20
+                } else {
+                    0
+                }
+            }
+        })
+    }
+
+    pub(crate) fn buffer_dirty_batch_pages(
+        &self,
+        resident_pages: usize,
+        dirty_pages: usize,
+    ) -> usize {
+        if dirty_pages == 0 {
+            return 1;
+        }
+        let raw = match self.buffer.dirty_batch {
+            BufferDirtyBatchStage::AllDurable => dirty_pages,
+            BufferDirtyBatchStage::HalfResident => dirty_pages.min((resident_pages / 2).max(1)),
+            BufferDirtyBatchStage::CheckpointThroughput => dirty_pages.min(256),
+            BufferDirtyBatchStage::Latency32 => dirty_pages.min(32),
+        };
+        raw.clamp(1, dirty_pages)
+    }
+
+    pub(crate) fn buffer_dirty_sort_key(&self, meta: DirtyFrameStageMeta) -> BufferDirtySortKey {
+        match self.buffer.dirty_order {
+            BufferDirtyOrderStage::ResidentOrder => BufferDirtySortKey(0, meta.page_id.0, 0),
+            BufferDirtyOrderStage::ByPageId => BufferDirtySortKey(0, meta.page_id.0, meta.page_lsn.0),
+            BufferDirtyOrderStage::ByLsn => BufferDirtySortKey(0, meta.page_lsn.0, meta.page_id.0),
+            BufferDirtyOrderStage::HighLsnLast => BufferDirtySortKey(0, meta.page_lsn.0, meta.page_id.0),
+        }
+    }
+
+    pub(crate) fn buffer_prefetch_cold_load(&self, resident_pages: usize, capacity: usize) -> bool {
+        match self.buffer.cold_prefetch {
+            BufferColdPrefetchStage::Always => true,
+            BufferColdPrefetchStage::Until90Percent => {
+                resident_pages.saturating_mul(10) < capacity.saturating_mul(9)
+            }
+            BufferColdPrefetchStage::Until75Percent => {
+                resident_pages.saturating_mul(4) < capacity.saturating_mul(3)
+            }
+            BufferColdPrefetchStage::Never => false,
+        }
+    }
+
+    pub(crate) fn heap_row_lane(&self, row_id: RowId, lane_count: usize) -> usize {
+        bounded_lane(
+            match self.heap.row_lane {
+                HeapLaneStage::Modulo => row_id.0,
+                HeapLaneStage::HashStripe => mix_u64(row_id.0),
+                HeapLaneStage::XorShift => row_id.0 ^ (row_id.0 >> 17) ^ (row_id.0 >> 41),
+            },
+            lane_count,
+        )
+    }
+
+    pub(crate) fn heap_relation_lane(&self, rel_id: RelId, lane_count: usize) -> usize {
+        bounded_lane(
+            match self.heap.relation_lane {
+                HeapLaneStage::Modulo => rel_id.0,
+                HeapLaneStage::HashStripe => mix_u64(rel_id.0),
+                HeapLaneStage::XorShift => rel_id.0 ^ (rel_id.0 >> 17) ^ (rel_id.0 >> 41),
+            },
+            lane_count,
+        )
+    }
+
+    pub(crate) fn heap_reusable_page(
+        &self,
+        kind: PageKind,
+        encoded_len: usize,
+        queued_pages: usize,
+    ) -> bool {
+        if queued_pages == 0 {
+            return false;
+        }
+        match self.heap.reusable_page {
+            HeapReusablePageStage::PreferAny => true,
+            HeapReusablePageStage::SmallTupleOnly => encoded_len <= 2048,
+            HeapReusablePageStage::HeapOnly => kind == PageKind::Heap,
+            HeapReusablePageStage::FreshFirst => false,
+        }
+    }
+
+    pub(crate) fn heap_undo_prefetch_next(&self, depth: usize, ptr: UndoPtr) -> bool {
+        if ptr == UndoPtr::ZERO {
+            return false;
+        }
+        match self.heap.undo_prefetch {
+            UndoPrefetchStage::Never => false,
+            UndoPrefetchStage::Shallow32 => depth < 32,
+            UndoPrefetchStage::Aggressive128 => depth < 128,
+        }
+    }
+
+    pub(crate) fn wal_write_batch_bytes(
+        &self,
+        ctx: crate::wal::policy::WalScheduleContext,
+    ) -> usize {
+        let configured = ctx.configured_write_batch_bytes.max(1);
+        match self.wal.write_batch {
+            WalWriteBatchStage::Configured => configured,
+            WalWriteBatchStage::TailLatencyQuarter => (configured / 4).max(64 * 1024),
+            WalWriteBatchStage::FanInAdaptive => {
+                if ctx.pending_bytes >= configured {
+                    ctx.pending_bytes.min(configured.saturating_mul(4))
+                } else {
+                    configured
+                }
+            }
+            WalWriteBatchStage::CheckpointFriendlyDouble => configured.saturating_mul(2).max(1),
+        }
+    }
+
+    pub(crate) fn wal_group_commit_delay_us(
+        &self,
+        ctx: crate::wal::policy::WalScheduleContext,
+    ) -> u64 {
+        let raw = match self.wal.group_delay {
+            WalGroupDelayStage::Configured => {
+                if ctx.flush_gap_bytes >= ctx.configured_max_group_bytes {
+                    0
+                } else {
+                    ctx.configured_delay_us
+                }
+            }
+            WalGroupDelayStage::TailLatency => {
+                if ctx.pending_records <= 1 {
+                    0
+                } else {
+                    ctx.configured_delay_us.min(50)
+                }
+            }
+            WalGroupDelayStage::FanInAdaptive => {
+                if ctx.flush_gap_bytes >= ctx.configured_max_group_bytes {
+                    0
+                } else if ctx.pending_records >= 16 {
+                    ctx.configured_delay_us / 2
+                } else {
+                    ctx.configured_delay_us
+                }
+            }
+            WalGroupDelayStage::NoDelay => 0,
+        };
+        raw.min(ctx.configured_delay_us)
+    }
+
+    pub(crate) fn wal_resample_flush_target(
+        &self,
+        ctx: crate::wal::policy::WalScheduleContext,
+    ) -> bool {
+        match self.wal.resample_flush_target {
+            WalResampleStage::Always => true,
+            WalResampleStage::OnlySmallPending => ctx.pending_bytes <= ctx.configured_write_batch_bytes,
+            WalResampleStage::OnlyIfGap => ctx.flush_gap_bytes > 0,
+            WalResampleStage::Never => false,
+        }
+    }
+
+    pub(crate) fn wal_drain_batch_bytes(
+        &self,
+        ctx: crate::wal::policy::WalScheduleContext,
+    ) -> usize {
+        let configured = ctx.configured_write_batch_bytes.max(1);
+        match self.wal.drain_batch {
+            WalDrainBatchStage::Configured => configured,
+            WalDrainBatchStage::MirrorWriteBatch => self.wal_write_batch_bytes(ctx),
+            WalDrainBatchStage::DoubleConfigured => configured.saturating_mul(2).max(1),
+            WalDrainBatchStage::Latency64K => 64 * 1024,
+        }
+    }
+}
