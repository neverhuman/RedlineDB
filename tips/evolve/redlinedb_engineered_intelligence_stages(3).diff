@@ -0,0 +1,305 @@
+//! Engineered-intelligence stage contracts for the RedlineDB kernel.
+//!
+//! A *stage* is a deliberately small policy surface that an evolutionary
+//! agent may replace. Stages are allowed to choose among legal options, but
+//! they are not allowed to define legality. Every public helper in this module
+//! is part of the guard/membrane layer that clamps advisory stage output before
+//! storage, MVCC, WAL, page-format, or B-tree invariants can observe it.
+
+use std::ops::Bound;
+
+use crate::format::{Lsn, PageId, PageKind, UndoPtr};
+
+/// Stable identifiers for stage families. These names are intended to appear
+/// in genome manifests, benchmark reports, and agent prompts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageSurface {
+    BufferVictim,
+    BufferDirtyBatch,
+    BufferDirtyOrder,
+    BufferPrefetch,
+    HeapLane,
+    HeapReuse,
+    UndoRead,
+    IndexCursorBatch,
+    IndexSiblingPrefetch,
+    IndexRangeStop,
+    IndexLeafSplit,
+    IndexDescent,
+    UniqueLockStripe,
+    RowLockBackoff,
+    CommitBarrier,
+    WalGroupCommit,
+    CheckpointSchedule,
+    RecoveryReplay,
+    VacuumCandidate,
+    CatalogPublish,
+    SqlPlan,
+    ScalarKernel,
+    VectorKernel,
+}
+
+/// How much authority a stage has over core behavior.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageSafety {
+    /// Deterministic pure function; correctness is checked by corpus equality.
+    Pure,
+    /// Advisory hint. The engine remains correct if it is ignored.
+    Advisory,
+    /// Output is consumed only after it passes a guard in this module.
+    Guarded,
+    /// Invariant-critical surface. It must have a reference fallback or
+    /// post-verification before it can be safely evolved.
+    InvariantCritical,
+}
+
+/// Machine-readable description of one stage implementation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageDescriptor {
+    pub surface: StageSurface,
+    pub stage_name: &'static str,
+    pub safety: StageSafety,
+    pub contract: &'static str,
+}
+
+/// Optional metadata hook for policy/stage implementations.
+pub trait StageSpec {
+    fn stage_descriptors() -> &'static [StageDescriptor];
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferVictimInput {
+    pub pin_count: usize,
+    pub dirty: bool,
+    pub usage_count: u8,
+    pub page_lsn: Lsn,
+    pub durable_lsn: Lsn,
+    pub write_in_progress: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DirtyBatchInput {
+    pub resident_pages: usize,
+    pub dirty_pages: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DirtyFrameInput {
+    pub page_id: PageId,
+    pub page_lsn: Lsn,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HeapReuseInput {
+    pub kind: PageKind,
+    pub encoded_len: usize,
+    pub queued_pages: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct UndoReadInput {
+    pub depth: usize,
+    pub ptr: UndoPtr,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexCursorInput {
+    pub entries_in_leaf: usize,
+    pub has_right_sibling: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexLeafSplitInput {
+    pub entries_len: usize,
+    pub body_capacity: usize,
+}
+
+pub const MAX_INDEX_CURSOR_BATCH: usize = 16 * 1024;
+pub const MAX_UNDO_CHAIN_DEPTH_HINT: usize = 1_048_576;
+
+/// Clamp a stage-selected lane into the legal lane domain.
+#[inline]
+pub const fn guard_lane(proposed: usize, lane_count: usize) -> usize {
+    if lane_count == 0 {
+        0
+    } else if proposed >= lane_count {
+        proposed % lane_count
+    } else {
+        proposed
+    }
+}
+
+/// Batch sizes must be non-zero and bounded so a bad gene cannot produce an
+/// empty infinite loop or a pathological allocation.
+#[inline]
+pub const fn guard_index_cursor_batch(proposed: usize) -> usize {
+    if proposed == 0 {
+        1
+    } else if proposed > MAX_INDEX_CURSOR_BATCH {
+        MAX_INDEX_CURSOR_BATCH
+    } else {
+        proposed
+    }
+}
+
+/// A B-tree leaf split for a non-trivial leaf must leave entries on both sides.
+#[inline]
+pub const fn guard_leaf_split_point(input: IndexLeafSplitInput, proposed: usize) -> usize {
+    if input.entries_len <= 1 {
+        input.entries_len
+    } else if proposed == 0 {
+        1
+    } else if proposed >= input.entries_len {
+        input.entries_len - 1
+    } else {
+        proposed
+    }
+}
+
+/// A flush policy can limit work, but cannot flush more frames than the kernel
+/// already selected as dirty-and-durable.
+#[inline]
+pub const fn guard_dirty_batch_pages(input: DirtyBatchInput, proposed: usize) -> usize {
+    if input.dirty_pages == 0 {
+        0
+    } else if proposed == 0 {
+        1
+    } else if proposed > input.dirty_pages {
+        input.dirty_pages
+    } else {
+        proposed
+    }
+}
+
+/// Force eviction safety regardless of what a replacement victim scorer emits.
+#[inline]
+pub const fn guard_buffer_victim_score(
+    input: BufferVictimInput,
+    proposed: Option<u32>,
+) -> Option<u32> {
+    if input.pin_count > 0
+        || input.usage_count > 0
+        || input.write_in_progress
+        || (input.dirty && input.page_lsn.0 > input.durable_lsn.0)
+    {
+        None
+    } else {
+        proposed
+    }
+}
+
+/// A reuse policy may prefer queued reusable pages, but it cannot invent one.
+#[inline]
+pub const fn guard_heap_reuse(input: HeapReuseInput, prefer_reusable: bool) -> bool {
+    prefer_reusable && input.queued_pages > 0
+}
+
+/// Undo prefetch is advisory and must never target the null sentinel.
+#[inline]
+pub const fn guard_undo_prefetch(input: UndoReadInput, proposed: bool) -> bool {
+    proposed && input.ptr.0 != 0 && input.depth < MAX_UNDO_CHAIN_DEPTH_HINT
+}
+
+/// Depth limits are hints. They must not be below the current cursor and must
+/// remain bounded to keep accidental huge values out of reports and manifests.
+#[inline]
+pub const fn guard_undo_depth_limit(input: UndoReadInput, proposed: Option<usize>) -> Option<usize> {
+    match proposed {
+        Some(raw) => {
+            let lower = input.depth.saturating_add(1);
+            let limited = if raw < lower { lower } else { raw };
+            if limited > MAX_UNDO_CHAIN_DEPTH_HINT {
+                Some(MAX_UNDO_CHAIN_DEPTH_HINT)
+            } else {
+                Some(limited)
+            }
+        }
+        None => None,
+    }
+}
+
+/// Sibling prefetch must be suppressed when the page header has no sibling.
+#[inline]
+pub const fn guard_index_sibling_prefetch(input: IndexCursorInput, proposed: bool) -> bool {
+    proposed && input.has_right_sibling
+}
+
+/// Exact reference implementation for range-scan early termination. Index
+/// cursor genes can reuse this or wrap it, but any divergent early-stop stage
+/// should be checked against this comparator before it is allowed to skip I/O.
+#[inline]
+pub fn default_stop_after_leaf(last_logical_key: Option<&[u8]>, end: &Bound<Vec<u8>>) -> bool {
+    let Some(last) = last_logical_key else {
+        return false;
+    };
+    match end {
+        Bound::Excluded(bound) => last >= bound.as_slice(),
+        Bound::Included(bound) => last > bound.as_slice(),
+        Bound::Unbounded => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::format::{Lsn, PageId, PageKind, UndoPtr};
+
+    #[test]
+    fn lane_guard_clamps_into_domain() {
+        assert_eq!(guard_lane(7, 4), 3);
+        assert_eq!(guard_lane(2, 4), 2);
+        assert_eq!(guard_lane(99, 0), 0);
+    }
+
+    #[test]
+    fn cursor_batch_guard_rejects_zero_and_absurd_values() {
+        assert_eq!(guard_index_cursor_batch(0), 1);
+        assert_eq!(guard_index_cursor_batch(256), 256);
+        assert_eq!(
+            guard_index_cursor_batch(MAX_INDEX_CURSOR_BATCH + 1),
+            MAX_INDEX_CURSOR_BATCH
+        );
+    }
+
+    #[test]
+    fn leaf_split_guard_keeps_non_trivial_splits_balanced() {
+        assert_eq!(guard_leaf_split_point(IndexLeafSplitInput { entries_len: 0, body_capacity: 0 }, 9), 0);
+        assert_eq!(guard_leaf_split_point(IndexLeafSplitInput { entries_len: 1, body_capacity: 0 }, 9), 1);
+        assert_eq!(guard_leaf_split_point(IndexLeafSplitInput { entries_len: 8, body_capacity: 0 }, 0), 1);
+        assert_eq!(guard_leaf_split_point(IndexLeafSplitInput { entries_len: 8, body_capacity: 0 }, 8), 7);
+        assert_eq!(guard_leaf_split_point(IndexLeafSplitInput { entries_len: 8, body_capacity: 0 }, 3), 3);
+    }
+
+    #[test]
+    fn dirty_batch_guard_stays_inside_candidate_set() {
+        assert_eq!(guard_dirty_batch_pages(DirtyBatchInput { resident_pages: 4, dirty_pages: 0 }, 9), 0);
+        assert_eq!(guard_dirty_batch_pages(DirtyBatchInput { resident_pages: 4, dirty_pages: 3 }, 0), 1);
+        assert_eq!(guard_dirty_batch_pages(DirtyBatchInput { resident_pages: 4, dirty_pages: 3 }, 9), 3);
+    }
+
+    #[test]
+    fn victim_guard_blocks_unsafe_evictions() {
+        let clean = BufferVictimInput {
+            pin_count: 0,
+            dirty: false,
+            usage_count: 0,
+            page_lsn: Lsn(1),
+            durable_lsn: Lsn(1),
+            write_in_progress: false,
+        };
+        assert_eq!(guard_buffer_victim_score(clean, Some(7)), Some(7));
+        assert_eq!(guard_buffer_victim_score(BufferVictimInput { pin_count: 1, ..clean }, Some(7)), None);
+        assert_eq!(guard_buffer_victim_score(BufferVictimInput { dirty: true, page_lsn: Lsn(2), durable_lsn: Lsn(1), ..clean }, Some(7)), None);
+    }
+
+    #[test]
+    fn advisory_guards_suppress_impossible_prefetches() {
+        assert!(!guard_heap_reuse(HeapReuseInput { kind: PageKind::Heap, encoded_len: 128, queued_pages: 0 }, true));
+        assert!(guard_heap_reuse(HeapReuseInput { kind: PageKind::Heap, encoded_len: 128, queued_pages: 1 }, true));
+        assert!(!guard_undo_prefetch(UndoReadInput { depth: 0, ptr: UndoPtr::ZERO }, true));
+        assert!(guard_undo_prefetch(UndoReadInput { depth: 0, ptr: UndoPtr(9) }, true));
+        assert!(!guard_index_sibling_prefetch(IndexCursorInput { entries_in_leaf: 4, has_right_sibling: false }, true));
+        assert!(guard_index_sibling_prefetch(IndexCursorInput { entries_in_leaf: 4, has_right_sibling: true }, true));
+        let _ = DirtyFrameInput { page_id: PageId(1), page_lsn: Lsn(1) };
+    }
+}
