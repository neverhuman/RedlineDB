+//! Public engineered-intelligence stage genome surface.
+//!
+//! `StageGenome` is intentionally metadata-first.  It gives benchmark and
+//! evolution harnesses a stable manifest/fingerprint while the current engine
+//! remains the default behavior.
+
+pub use redlinedb_kernel::stages::{
+    BufferFrameMeta, BufferResidencyStage, DirtyFlushStage, HeapPlacementStage,
+    KernelStageGenome, ReusablePageStage, StageGene, StageSafetyClass, UndoReadStage,
+    WalScheduleStage, WalScheduleStageContext,
+};
+pub use redlinedb_sql::stages::{
+    AggregateChoiceContext, ExecBatchStage, JoinChoiceContext, PlannerChoiceStage,
+    SortChoiceContext, SqlStageGenome,
+};
+
+/// Public genome used by `OpenOptions`.
+pub type StageGenome = SqlStageGenome;
