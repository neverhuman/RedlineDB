+//! SQL-layer engineered-intelligence stage genome.
+//!
+//! The SQL genome nests the kernel genome because `redlinedb` opens through
+//! the SQL crate and then builds a kernel `EngineConfig`.
+
+use std::collections::hash_map::DefaultHasher;
+use std::hash::{Hash, Hasher};
+
+pub use redlinedb_kernel::stages::{KernelStageGenome, StageGene, StageSafetyClass};
+
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct SqlStageGenome {
+    pub kernel: KernelStageGenome,
+    pub access_path_selection: StageGene,
+    pub join_choice: StageGene,
+    pub aggregate_choice: StageGene,
+    pub ordering_choice: StageGene,
+    pub exec_batch: StageGene,
+    pub materialization: StageGene,
+    pub analyze_sampling: StageGene,
+    pub statement_dispatch: StageGene,
+}
+
+impl Default for SqlStageGenome {
+    fn default() -> Self {
+        Self {
+            kernel: KernelStageGenome::default(),
+            access_path_selection: StageGene::current(
+                "sql.access_path_selection",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            join_choice: StageGene::current(
+                "sql.join_choice",
+                StageSafetyClass::ReplacementReady,
+            ),
+            aggregate_choice: StageGene::current(
+                "sql.aggregate_choice",
+                StageSafetyClass::ReplacementReady,
+            ),
+            ordering_choice: StageGene::current(
+                "sql.ordering_choice",
+                StageSafetyClass::ReplacementReady,
+            ),
+            exec_batch: StageGene::current("sql.exec_batch", StageSafetyClass::ReplacementReady),
+            materialization: StageGene::current(
+                "sql.materialization",
+                StageSafetyClass::ReplacementReady,
+            ),
+            analyze_sampling: StageGene::current(
+                "sql.analyze_sampling",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            statement_dispatch: StageGene::current(
+                "sql.statement_dispatch",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+        }
+    }
+}
+
+impl SqlStageGenome {
+    #[must_use]
+    pub fn stable_fingerprint(&self) -> u64 {
+        let mut hasher = DefaultHasher::new();
+        self.hash(&mut hasher);
+        hasher.finish()
+    }
+
+    #[must_use]
+    pub fn sql_genes(&self) -> [&StageGene; 8] {
+        [
+            &self.access_path_selection,
+            &self.join_choice,
+            &self.aggregate_choice,
+            &self.ordering_choice,
+            &self.exec_batch,
+            &self.materialization,
+            &self.analyze_sampling,
+            &self.statement_dispatch,
+        ]
+    }
+}
+
+/// Planner-stage contract for replacement-ready plan-shape decisions.
+pub trait PlannerChoiceStage {
+    type JoinKind;
+    type PhysicalKind;
+
+    fn choose_join_kind(ctx: JoinChoiceContext) -> Self::JoinKind;
+    fn aggregate_kind(ctx: AggregateChoiceContext) -> Self::PhysicalKind;
+    fn ordering_kind(ctx: SortChoiceContext) -> Self::PhysicalKind;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct JoinChoiceContext {
+    pub left_rows: f64,
+    pub right_rows: f64,
+    pub has_indexable_equality: bool,
+    pub has_equality: bool,
+    pub has_selection: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct AggregateChoiceContext {
+    pub input_rows: f64,
+    pub group_cols: usize,
+    pub ordered: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SortChoiceContext {
+    pub limit: Option<usize>,
+}
+
+/// Executor-stage contract for replacement-ready batch sizing.
+pub trait ExecBatchStage {
+    fn row_batch_rows() -> usize;
+    fn index_rowid_batch() -> usize;
+    fn materialize_rows(row_width: usize, memory_budget: usize) -> usize;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_sql_genome_fingerprints_kernel_and_sql_genes() {
+        let genome = SqlStageGenome::default();
+        assert_ne!(genome.stable_fingerprint(), 0);
+        assert_eq!(genome.kernel.genes().len(), 19);
+        assert_eq!(genome.sql_genes().len(), 8);
+    }
+}
