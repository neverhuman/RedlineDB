@@ -0,0 +1,274 @@
+//! Engineered-intelligence stage contracts for the storage kernel.
+//!
+//! This module deliberately starts with **metadata and contract boundaries**,
+//! not runtime hot-swapping.  The current implementation remains the default
+//! genome.  Candidate engines can now name the stage family they replace,
+//! record a stable fingerprint in benchmark manifests, and refuse accidental
+//! process-global reuse with a differently staged engine.
+
+use std::collections::hash_map::DefaultHasher;
+use std::hash::{Hash, Hasher};
+
+/// Declares how freely a stage can be mixed with unrelated stage genes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageSafetyClass {
+    /// The stage is a bounded policy decision and can be freely mixed with
+    /// other replacement-ready genes after trait-level invariant tests pass.
+    ReplacementReady,
+    /// The stage is performance-critical but shares semantics with other
+    /// stages.  A candidate must declare a compatible semantic family.
+    CoordinatedReplacement,
+    /// The stage is named for observability and future evolution, but must not
+    /// change durable bytes or semantics without a format/semantic epoch.
+    HookOnly,
+}
+
+/// Stable identity for a stage implementation.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct StageGene {
+    /// Stable family name, e.g. `kernel.wal_schedule`.
+    pub family: &'static str,
+    /// Stable implementation name, e.g. `current.wal_schedule`.
+    pub implementation: &'static str,
+    /// Interface contract version for this family.
+    pub contract_version: u16,
+    /// Optional parameter hash.  Zero means the implementation is unparameterized.
+    pub params_hash: u64,
+    /// Safety class for cross-gene mixing.
+    pub safety: StageSafetyClass,
+}
+
+impl StageGene {
+    #[must_use]
+    pub const fn new(
+        family: &'static str,
+        implementation: &'static str,
+        contract_version: u16,
+        params_hash: u64,
+        safety: StageSafetyClass,
+    ) -> Self {
+        Self {
+            family,
+            implementation,
+            contract_version,
+            params_hash,
+            safety,
+        }
+    }
+
+    #[must_use]
+    pub const fn current(family: &'static str, safety: StageSafetyClass) -> Self {
+        Self::new(family, "current", 1, 0, safety)
+    }
+}
+
+/// Kernel-stage genome.  Several fields cover multiple method-level slots;
+/// the grouping is intentional so agents do not accidentally split invariants
+/// that must evolve together.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct KernelStageGenome {
+    pub tuple_visibility: StageGene,
+    pub tx_status_frontier: StageGene,
+    pub write_conflict: StageGene,
+    pub row_locking: StageGene,
+    pub row_id_allocation: StageGene,
+    pub heap_placement: StageGene,
+    pub reusable_page: StageGene,
+    pub undo_read: StageGene,
+    pub buffer_residency: StageGene,
+    pub dirty_flush: StageGene,
+    pub wal_schedule: StageGene,
+    pub durability_barrier: StageGene,
+    pub recovery_replay: StageGene,
+    pub catalog_codec: StageGene,
+    pub index_access: StageGene,
+    pub index_maintenance: StageGene,
+    pub checkpoint_pacing: StageGene,
+    pub page_format_hook: StageGene,
+    pub wal_format_hook: StageGene,
+}
+
+impl Default for KernelStageGenome {
+    fn default() -> Self {
+        Self {
+            tuple_visibility: StageGene::current(
+                "kernel.tuple_visibility",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            tx_status_frontier: StageGene::current(
+                "kernel.tx_status_frontier",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            write_conflict: StageGene::current(
+                "kernel.write_conflict",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            row_locking: StageGene::current(
+                "kernel.row_locking",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            row_id_allocation: StageGene::current(
+                "kernel.row_id_allocation",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            heap_placement: StageGene::current(
+                "kernel.heap_placement",
+                StageSafetyClass::ReplacementReady,
+            ),
+            reusable_page: StageGene::current(
+                "kernel.reusable_page",
+                StageSafetyClass::ReplacementReady,
+            ),
+            undo_read: StageGene::current(
+                "kernel.undo_read",
+                StageSafetyClass::ReplacementReady,
+            ),
+            buffer_residency: StageGene::current(
+                "kernel.buffer_residency",
+                StageSafetyClass::ReplacementReady,
+            ),
+            dirty_flush: StageGene::current(
+                "kernel.dirty_flush",
+                StageSafetyClass::ReplacementReady,
+            ),
+            wal_schedule: StageGene::current(
+                "kernel.wal_schedule",
+                StageSafetyClass::ReplacementReady,
+            ),
+            durability_barrier: StageGene::current(
+                "kernel.durability_barrier",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            recovery_replay: StageGene::current(
+                "kernel.recovery_replay",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            catalog_codec: StageGene::current(
+                "kernel.catalog_codec",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            index_access: StageGene::current(
+                "kernel.index_access",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            index_maintenance: StageGene::current(
+                "kernel.index_maintenance",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            checkpoint_pacing: StageGene::current(
+                "kernel.checkpoint_pacing",
+                StageSafetyClass::CoordinatedReplacement,
+            ),
+            page_format_hook: StageGene::current(
+                "kernel.page_format",
+                StageSafetyClass::HookOnly,
+            ),
+            wal_format_hook: StageGene::current(
+                "kernel.wal_format",
+                StageSafetyClass::HookOnly,
+            ),
+        }
+    }
+}
+
+impl KernelStageGenome {
+    /// Deterministic process-local fingerprint for manifests and registry keys.
+    #[must_use]
+    pub fn stable_fingerprint(&self) -> u64 {
+        let mut hasher = DefaultHasher::new();
+        self.hash(&mut hasher);
+        hasher.finish()
+    }
+
+    /// Iterate the genes in a stable order for manifest rendering.
+    #[must_use]
+    pub fn genes(&self) -> [&StageGene; 19] {
+        [
+            &self.tuple_visibility,
+            &self.tx_status_frontier,
+            &self.write_conflict,
+            &self.row_locking,
+            &self.row_id_allocation,
+            &self.heap_placement,
+            &self.reusable_page,
+            &self.undo_read,
+            &self.buffer_residency,
+            &self.dirty_flush,
+            &self.wal_schedule,
+            &self.durability_barrier,
+            &self.recovery_replay,
+            &self.catalog_codec,
+            &self.index_access,
+            &self.index_maintenance,
+            &self.checkpoint_pacing,
+            &self.page_format_hook,
+            &self.wal_format_hook,
+        ]
+    }
+}
+
+/// Trait shared by replacement-ready heap placement policies.
+pub trait HeapPlacementStage {
+    fn row_lane(row_id: crate::format::RowId, lane_count: usize) -> usize;
+    fn relation_lane(rel_id: crate::format::RelId, lane_count: usize) -> usize;
+}
+
+/// Trait shared by replacement-ready heap reusable-page policies.
+pub trait ReusablePageStage {
+    fn prefer_reusable_page(
+        kind: crate::format::PageKind,
+        encoded_len: usize,
+        queued_pages: usize,
+    ) -> bool;
+}
+
+/// Trait shared by replacement-ready undo read policies.
+pub trait UndoReadStage {
+    fn prefetch_next(depth: usize, ptr: crate::format::UndoPtr) -> bool;
+    fn depth_limit_hint(depth: usize, ptr: crate::format::UndoPtr) -> Option<usize>;
+}
+
+/// Trait shared by replacement-ready buffer residency policies.
+pub trait BufferResidencyStage {
+    fn victim_score(meta: BufferFrameMeta) -> Option<u32>;
+    fn prefetch_cold_load(resident_pages: usize, capacity: usize) -> bool;
+}
+
+/// Public, lossless subset of buffer frame metadata that replacement policies
+/// may inspect without borrowing internal frame state.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferFrameMeta {
+    pub pin_count: usize,
+    pub dirty: bool,
+    pub usage_count: u8,
+    pub page_lsn: crate::format::Lsn,
+    pub durable_lsn: crate::format::Lsn,
+}
+
+/// Trait shared by replacement-ready dirty-page flush policies.
+pub trait DirtyFlushStage {
+    fn dirty_batch_pages(resident_pages: usize, dirty_pages: usize) -> usize;
+}
+
+/// Trait shared by replacement-ready WAL scheduling policies.
+pub trait WalScheduleStage {
+    fn write_batch_bytes(ctx: WalScheduleStageContext) -> usize;
+    fn group_commit_delay_us(ctx: WalScheduleStageContext) -> u64;
+    fn resample_flush_target(ctx: WalScheduleStageContext) -> bool;
+    fn drain_batch_bytes(ctx: WalScheduleStageContext) -> usize;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WalScheduleStageContext {
+    pub pending_bytes: usize,
+    pub pending_records: usize,
+    pub flush_gap_bytes: u64,
+    pub configured_write_batch_bytes: usize,
+    pub configured_delay_us: u64,
+    pub configured_max_group_bytes: u64,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_kernel_genome_has_stable_nonzero_fingerprint() {
+        let genome = KernelStageGenome::default();
+        assert_ne!(genome.stable_fingerprint(), 0);
+        assert_eq!(genome.genes().len(), 19);
+    }
+}
