+//! Standard stage ABI for RedlineDB kernel evolution.
+//!
+//! Stages are small, audited policy surfaces. They may choose among valid
+//! performance strategies, but they must not redefine storage, WAL, MVCC,
+//! locking, recovery, or catalog correctness.
+
+use std::sync::Arc;
+
+use crate::format::{Lsn, PageId, PageKind, RelId, RowId, UndoPtr};
+use crate::Result;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageFamily {
+    WalSchedule,
+    BufferPolicy,
+    HeapPlacement,
+    UndoTraversal,
+    IndexCursor,
+    LeafSplit,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageSafetyTier {
+    PurePolicy,
+    AdvisoryOnly,
+    GuardedKernel,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StageManifest {
+    pub family: StageFamily,
+    pub name: &'static str,
+    pub version: u32,
+    pub safety_tier: StageSafetyTier,
+    pub deterministic: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct StageAuditError {
+    pub family: StageFamily,
+    pub message: &'static str,
+}
+
+pub type StageAuditResult = std::result::Result<(), StageAuditError>;
+
+pub trait Stage: Send + Sync + 'static {
+    fn manifest(&self) -> StageManifest;
+
+    fn audit(&self) -> StageAuditResult {
+        let manifest = self.manifest();
+        if manifest.name.trim().is_empty() {
+            return Err(StageAuditError {
+                family: manifest.family,
+                message: "stage name must not be empty",
+            });
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WalScheduleStageContext {
+    pub pending_bytes: usize,
+    pub pending_records: usize,
+    pub flush_gap_bytes: u64,
+    pub configured_write_batch_bytes: usize,
+    pub configured_delay_us: u64,
+    pub configured_max_group_bytes: u64,
+}
+
+pub trait WalScheduleStage: Stage {
+    fn write_batch_bytes(&self, ctx: WalScheduleStageContext) -> usize;
+    fn group_commit_delay_us(&self, ctx: WalScheduleStageContext) -> u64;
+    fn resample_flush_target(&self, ctx: WalScheduleStageContext) -> bool;
+    fn drain_batch_bytes(&self, ctx: WalScheduleStageContext) -> usize;
+
+    fn audit_wal_schedule(&self) -> StageAuditResult {
+        self.audit()?;
+        let ctx = WalScheduleStageContext {
+            pending_bytes: 512 * 1024,
+            pending_records: 8,
+            flush_gap_bytes: 256 * 1024,
+            configured_write_batch_bytes: 1024 * 1024,
+            configured_delay_us: 200,
+            configured_max_group_bytes: 4 * 1024 * 1024,
+        };
+        if self.write_batch_bytes(ctx) == 0 || self.drain_batch_bytes(ctx) == 0 {
+            return Err(StageAuditError {
+                family: StageFamily::WalSchedule,
+                message: "WAL batch sizes must be nonzero",
+            });
+        }
+        if self.group_commit_delay_us(ctx) > ctx.configured_delay_us {
+            return Err(StageAuditError {
+                family: StageFamily::WalSchedule,
+                message: "group commit delay must not exceed configured delay",
+            });
+        }
+        let _ = self.resample_flush_target(ctx);
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferFrameStageMeta {
+    pub pin_count: usize,
+    pub dirty: bool,
+    pub usage_count: u8,
+    pub page_lsn: Lsn,
+    pub durable_lsn: Lsn,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct DirtyFrameStageMeta {
+    pub page_id: PageId,
+    pub page_lsn: Lsn,
+}
+
+pub trait BufferPolicyStage: Stage {
+    fn victim_score(&self, meta: BufferFrameStageMeta) -> Option<u32>;
+    fn dirty_batch_pages(&self, resident_pages: usize, dirty_pages: usize) -> usize;
+    fn sort_dirty_frames(&self, frames: &mut [DirtyFrameStageMeta]);
+    fn prefetch_cold_load(&self, resident_pages: usize, capacity: usize) -> bool;
+
+    fn audit_buffer_policy(&self) -> StageAuditResult {
+        self.audit()?;
+        let clean = BufferFrameStageMeta {
+            pin_count: 0,
+            dirty: false,
+            usage_count: 0,
+            page_lsn: Lsn(1),
+            durable_lsn: Lsn(1),
+        };
+        let pinned = BufferFrameStageMeta {
+            pin_count: 1,
+            ..clean
+        };
+        let undurable_dirty = BufferFrameStageMeta {
+            dirty: true,
+            page_lsn: Lsn(2),
+            durable_lsn: Lsn(1),
+            ..clean
+        };
+        if self.victim_score(clean).is_none() {
+            return Err(StageAuditError {
+                family: StageFamily::BufferPolicy,
+                message: "clean unpinned frame must remain evictable",
+            });
+        }
+        if self.victim_score(pinned).is_some() || self.victim_score(undurable_dirty).is_some() {
+            return Err(StageAuditError {
+                family: StageFamily::BufferPolicy,
+                message: "pinned or undurable dirty frames must not be evictable",
+            });
+        }
+        if self.dirty_batch_pages(128, 64) == 0 {
+            return Err(StageAuditError {
+                family: StageFamily::BufferPolicy,
+                message: "dirty batch size must be nonzero when dirty pages exist",
+            });
+        }
+        let mut dirty = [
+            DirtyFrameStageMeta {
+                page_id: PageId(2),
+                page_lsn: Lsn(2),
+            },
+            DirtyFrameStageMeta {
+                page_id: PageId(1),
+                page_lsn: Lsn(1),
+            },
+        ];
+        self.sort_dirty_frames(&mut dirty);
+        let _ = self.prefetch_cold_load(1, 2);
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReuseStageDecision {
+    PreferReusable,
+    AllocateFresh,
+}
+
+pub trait HeapPlacementStage: Stage {
+    fn row_lane(&self, row_id: RowId, lane_count: usize) -> usize;
+    fn relation_lane(&self, rel_id: RelId, lane_count: usize) -> usize;
+    fn reusable_page(
+        &self,
+        kind: PageKind,
+        encoded_len: usize,
+        queued_pages: usize,
+    ) -> ReuseStageDecision;
+
+    fn audit_heap_placement(&self) -> StageAuditResult {
+        self.audit()?;
+        for lanes in [1_usize, 2, 4, 17] {
+            if self.row_lane(RowId(9), lanes) >= lanes {
+                return Err(StageAuditError {
+                    family: StageFamily::HeapPlacement,
+                    message: "row lane out of bounds",
+                });
+            }
+            if self.relation_lane(RelId(11), lanes) >= lanes {
+                return Err(StageAuditError {
+                    family: StageFamily::HeapPlacement,
+                    message: "relation lane out of bounds",
+                });
+            }
+        }
+        let _ = self.reusable_page(PageKind::Heap, 128, 0);
+        let _ = self.reusable_page(PageKind::Undo, 128, 2);
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct UndoTraversalStageContext {
+    pub depth: usize,
+    pub next_ptr: UndoPtr,
+}
+
+pub trait UndoTraversalStage: Stage {
+    /// Advisory only. The core undo traversal remains responsible for reading
+    /// until visibility is resolved; a generated stage must never terminate the
+    /// search early or manufacture visibility.
+    fn prefetch_next(&self, ctx: UndoTraversalStageContext) -> bool;
+
+    fn audit_undo_traversal(&self) -> StageAuditResult {
+        self.audit()?;
+        let _ = self.prefetch_next(UndoTraversalStageContext {
+            depth: 0,
+            next_ptr: UndoPtr::ZERO,
+        });
+        let _ = self.prefetch_next(UndoTraversalStageContext {
+            depth: 32,
+            next_ptr: UndoPtr(1),
+        });
+        Ok(())
+    }
+}
+
+pub trait IndexCursorStage: Stage {
+    fn vec_wrapper_batch(&self) -> usize;
+    fn raw_cursor_batch(&self) -> usize;
+    fn prefetch_right_sibling(&self, entries_in_leaf: usize, has_right: bool) -> bool;
+
+    fn audit_index_cursor(&self) -> StageAuditResult {
+        self.audit()?;
+        if self.vec_wrapper_batch() == 0 || self.raw_cursor_batch() == 0 {
+            return Err(StageAuditError {
+                family: StageFamily::IndexCursor,
+                message: "cursor batches must be nonzero",
+            });
+        }
+        if self.vec_wrapper_batch() > 65_536 || self.raw_cursor_batch() > 65_536 {
+            return Err(StageAuditError {
+                family: StageFamily::IndexCursor,
+                message: "cursor batches exceed protected cap",
+            });
+        }
+        let _ = self.prefetch_right_sibling(64, true);
+        let _ = self.prefetch_right_sibling(0, false);
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DuplicateSplitStageMode {
+    KeepRunTogether,
+    PhysicalSeparator,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LeafSplitEntryMeta {
+    pub logical_key: Vec<u8>,
+}
+
+pub trait LeafSplitStage: Stage {
+    fn split_point(&self, entries: &[LeafSplitEntryMeta], body_capacity: usize) -> usize;
+    fn duplicate_mode(
+        &self,
+        entries: &[LeafSplitEntryMeta],
+        split: usize,
+    ) -> DuplicateSplitStageMode;
+
+    fn audit_leaf_split(&self) -> StageAuditResult {
+        self.audit()?;
+        let entries = vec![
+            LeafSplitEntryMeta {
+                logical_key: b"a".to_vec(),
+            },
+            LeafSplitEntryMeta {
+                logical_key: b"b".to_vec(),
+            },
+            LeafSplitEntryMeta {
+                logical_key: b"c".to_vec(),
+            },
+            LeafSplitEntryMeta {
+                logical_key: b"d".to_vec(),
+            },
+        ];
+        let split = self.split_point(&entries, 4096);
+        if split == 0 || split >= entries.len() {
+            return Err(StageAuditError {
+                family: StageFamily::LeafSplit,
+                message: "leaf split point must be inside the page body",
+            });
+        }
+        let _ = self.duplicate_mode(&entries, split);
+        Ok(())
+    }
+}
+
+#[derive(Clone)]
+pub struct KernelStageSet {
+    pub wal_schedule: Arc<dyn WalScheduleStage>,
+    pub buffer_policy: Arc<dyn BufferPolicyStage>,
+    pub heap_placement: Arc<dyn HeapPlacementStage>,
+    pub undo_traversal: Arc<dyn UndoTraversalStage>,
+    pub index_cursor: Arc<dyn IndexCursorStage>,
+    pub leaf_split: Arc<dyn LeafSplitStage>,
+}
+
+impl Default for KernelStageSet {
+    fn default() -> Self {
+        Self {
+            wal_schedule: Arc::new(DefaultWalScheduleStage),
+            buffer_policy: Arc::new(DefaultBufferPolicyStage),
+            heap_placement: Arc::new(DefaultHeapPlacementStage),
+            undo_traversal: Arc::new(DefaultUndoTraversalStage),
+            index_cursor: Arc::new(DefaultIndexCursorStage),
+            leaf_split: Arc::new(DefaultLeafSplitStage),
+        }
+    }
+}
+
+impl KernelStageSet {
+    pub fn audit(&self) -> Result<()> {
+        self.wal_schedule.audit_wal_schedule().map_err(audit_to_error)?;
+        self.buffer_policy.audit_buffer_policy().map_err(audit_to_error)?;
+        self.heap_placement.audit_heap_placement().map_err(audit_to_error)?;
+        self.undo_traversal.audit_undo_traversal().map_err(audit_to_error)?;
+        self.index_cursor.audit_index_cursor().map_err(audit_to_error)?;
+        self.leaf_split.audit_leaf_split().map_err(audit_to_error)?;
+        Ok(())
+    }
+
+    pub fn manifests(&self) -> [StageManifest; 6] {
+        [
+            self.wal_schedule.manifest(),
+            self.buffer_policy.manifest(),
+            self.heap_placement.manifest(),
+            self.undo_traversal.manifest(),
+            self.index_cursor.manifest(),
+            self.leaf_split.manifest(),
+        ]
+    }
+}
+
+fn audit_to_error(error: StageAuditError) -> crate::Error {
+    crate::Error::CorruptPage(error.message)
+}
+
+pub struct DefaultWalScheduleStage;
+
+impl Stage for DefaultWalScheduleStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::WalSchedule,
+            name: "wal_schedule_default",
+            version: 1,
+            safety_tier: StageSafetyTier::PurePolicy,
+            deterministic: true,
+        }
+    }
+}
+
+impl WalScheduleStage for DefaultWalScheduleStage {
+    fn write_batch_bytes(&self, ctx: WalScheduleStageContext) -> usize {
+        ctx.configured_write_batch_bytes.max(1)
+    }
+
+    fn group_commit_delay_us(&self, ctx: WalScheduleStageContext) -> u64 {
+        if ctx.flush_gap_bytes >= ctx.configured_max_group_bytes {
+            0
+        } else {
+            ctx.configured_delay_us
+        }
+    }
+
+    fn resample_flush_target(&self, _ctx: WalScheduleStageContext) -> bool {
+        true
+    }
+
+    fn drain_batch_bytes(&self, ctx: WalScheduleStageContext) -> usize {
+        ctx.configured_write_batch_bytes.max(1)
+    }
+}
+
+pub struct DefaultBufferPolicyStage;
+
+impl Stage for DefaultBufferPolicyStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::BufferPolicy,
+            name: "buffer_clock_default",
+            version: 1,
+            safety_tier: StageSafetyTier::GuardedKernel,
+            deterministic: true,
+        }
+    }
+}
+
+impl BufferPolicyStage for DefaultBufferPolicyStage {
+    fn victim_score(&self, meta: BufferFrameStageMeta) -> Option<u32> {
+        if meta.pin_count > 0
+            || meta.usage_count > 0
+            || (meta.dirty && meta.page_lsn > meta.durable_lsn)
+        {
+            return None;
+        }
+        Some(if meta.dirty { 10 } else { 0 })
+    }
+
+    fn dirty_batch_pages(&self, _resident_pages: usize, dirty_pages: usize) -> usize {
+        dirty_pages.max(usize::from(dirty_pages > 0))
+    }
+
+    fn sort_dirty_frames(&self, _frames: &mut [DirtyFrameStageMeta]) {}
+
+    fn prefetch_cold_load(&self, _resident_pages: usize, _capacity: usize) -> bool {
+        true
+    }
+}
+
+pub struct DefaultHeapPlacementStage;
+
+impl Stage for DefaultHeapPlacementStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::HeapPlacement,
+            name: "heap_modulo_default",
+            version: 1,
+            safety_tier: StageSafetyTier::PurePolicy,
+            deterministic: true,
+        }
+    }
+}
+
+impl HeapPlacementStage for DefaultHeapPlacementStage {
+    fn row_lane(&self, row_id: RowId, lane_count: usize) -> usize {
+        row_id.0 as usize % lane_count.max(1)
+    }
+
+    fn relation_lane(&self, rel_id: RelId, lane_count: usize) -> usize {
+        rel_id.0 as usize % lane_count.max(1)
+    }
+
+    fn reusable_page(
+        &self,
+        _kind: PageKind,
+        _encoded_len: usize,
+        queued_pages: usize,
+    ) -> ReuseStageDecision {
+        if queued_pages > 0 {
+            ReuseStageDecision::PreferReusable
+        } else {
+            ReuseStageDecision::AllocateFresh
+        }
+    }
+}
+
+pub struct DefaultUndoTraversalStage;
+
+impl Stage for DefaultUndoTraversalStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::UndoTraversal,
+            name: "undo_traversal_default",
+            version: 1,
+            safety_tier: StageSafetyTier::AdvisoryOnly,
+            deterministic: true,
+        }
+    }
+}
+
+impl UndoTraversalStage for DefaultUndoTraversalStage {
+    fn prefetch_next(&self, _ctx: UndoTraversalStageContext) -> bool {
+        false
+    }
+}
+
+pub struct DefaultIndexCursorStage;
+
+impl Stage for DefaultIndexCursorStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::IndexCursor,
+            name: "index_cursor_default",
+            version: 1,
+            safety_tier: StageSafetyTier::AdvisoryOnly,
+            deterministic: true,
+        }
+    }
+}
+
+impl IndexCursorStage for DefaultIndexCursorStage {
+    fn vec_wrapper_batch(&self) -> usize {
+        256
+    }
+
+    fn raw_cursor_batch(&self) -> usize {
+        256
+    }
+
+    fn prefetch_right_sibling(&self, _entries_in_leaf: usize, has_right: bool) -> bool {
+        has_right
+    }
+}
+
+pub struct DefaultLeafSplitStage;
+
+impl Stage for DefaultLeafSplitStage {
+    fn manifest(&self) -> StageManifest {
+        StageManifest {
+            family: StageFamily::LeafSplit,
+            name: "leaf_split_default",
+            version: 1,
+            safety_tier: StageSafetyTier::GuardedKernel,
+            deterministic: true,
+        }
+    }
+}
+
+impl DefaultLeafSplitStage {
+    fn midpoint_distinct_boundary(entries: &[LeafSplitEntryMeta]) -> usize {
+        let n = entries.len();
+        if n <= 1 {
+            return n;
+        }
+        let mid = n / 2;
+        for offset in 0..n {
+            for &candidate in &[mid.saturating_add(offset), mid.saturating_sub(offset)] {
+                if candidate == 0 || candidate >= n {
+                    continue;
+                }
+                if entries[candidate - 1].logical_key != entries[candidate].logical_key {
+                    return candidate;
+                }
+            }
+        }
+        mid
+    }
+}
+
+impl LeafSplitStage for DefaultLeafSplitStage {
+    fn split_point(&self, entries: &[LeafSplitEntryMeta], _body_capacity: usize) -> usize {
+        Self::midpoint_distinct_boundary(entries)
+    }
+
+    fn duplicate_mode(
+        &self,
+        entries: &[LeafSplitEntryMeta],
+        split: usize,
+    ) -> DuplicateSplitStageMode {
+        if split == 0 || split >= entries.len() {
+            return DuplicateSplitStageMode::KeepRunTogether;
+        }
+        if entries[split - 1].logical_key == entries[split].logical_key {
+            DuplicateSplitStageMode::PhysicalSeparator
+        } else {
+            DuplicateSplitStageMode::KeepRunTogether
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_kernel_stage_set_passes_audit() {
+        KernelStageSet::default().audit().expect("default stages audit");
+    }
+
+    #[test]
+    fn default_kernel_stage_set_has_unique_families() {
+        let manifests = KernelStageSet::default().manifests();
+        let mut families = manifests.iter().map(|m| m.family).collect::<Vec<_>>();
+        families.sort_by_key(|f| *f as u8);
+        families.dedup();
+        assert_eq!(families.len(), manifests.len());
+    }
+}
