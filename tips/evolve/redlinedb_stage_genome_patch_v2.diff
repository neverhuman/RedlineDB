+//! Standard stage ABI for SQL-layer evolution.
+//!
+//! SQL stages choose among already-supported executor strategies. They must not
+//! alter SQL semantics, expression truth tables, output ordering guarantees, or
+//! transaction behavior.
+
+use std::sync::Arc;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum SqlStageFamily {
+    Planner,
+    QueryMemory,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SqlStageManifest {
+    pub family: SqlStageFamily,
+    pub name: &'static str,
+    pub version: u32,
+    pub deterministic: bool,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SqlStageAuditError {
+    pub family: SqlStageFamily,
+    pub message: &'static str,
+}
+
+pub type SqlStageAuditResult = std::result::Result<(), SqlStageAuditError>;
+
+pub trait SqlStage: Send + Sync + 'static {
+    fn manifest(&self) -> SqlStageManifest;
+
+    fn audit(&self) -> SqlStageAuditResult {
+        let manifest = self.manifest();
+        if manifest.name.trim().is_empty() {
+            return Err(SqlStageAuditError {
+                family: manifest.family,
+                message: "stage name must not be empty",
+            });
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SqlJoinStageKind {
+    NestedLoop,
+    IndexNestedLoop,
+    Hash,
+    Cross,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SqlAggregateStageKind {
+    Streaming,
+    Hash,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SqlOrderingStageKind {
+    Sort,
+    TopN,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct JoinChoiceStageContext {
+    pub left_rows: f64,
+    pub right_rows: f64,
+    pub has_indexable_equality: bool,
+    pub has_equality: bool,
+    pub has_selection: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct AggregateChoiceStageContext {
+    pub input_rows: f64,
+    pub group_cols: usize,
+    pub ordered: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SortChoiceStageContext {
+    pub limit: Option<usize>,
+}
+
+pub trait SqlPlannerStage: SqlStage {
+    fn choose_join_kind(&self, ctx: JoinChoiceStageContext) -> SqlJoinStageKind;
+    fn aggregate_kind(&self, ctx: AggregateChoiceStageContext) -> SqlAggregateStageKind;
+    fn ordering_kind(&self, ctx: SortChoiceStageContext) -> SqlOrderingStageKind;
+
+    fn audit_planner(&self) -> SqlStageAuditResult {
+        self.audit()?;
+        let selected_join = self.choose_join_kind(JoinChoiceStageContext {
+            left_rows: 4096.0,
+            right_rows: 4096.0,
+            has_indexable_equality: true,
+            has_equality: true,
+            has_selection: true,
+        });
+        if selected_join == SqlJoinStageKind::Cross {
+            return Err(SqlStageAuditError {
+                family: SqlStageFamily::Planner,
+                message: "planner must not emit cross join when a join selection exists",
+            });
+        }
+        let _ = self.aggregate_kind(AggregateChoiceStageContext {
+            input_rows: 4096.0,
+            group_cols: 1,
+            ordered: false,
+        });
+        let _ = self.ordering_kind(SortChoiceStageContext { limit: Some(32) });
+        Ok(())
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum SqlOperatorClass {
+    Scan,
+    Sort,
+    TopN,
+    HashJoin,
+    HashAggregate,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct QueryMemoryStageContext {
+    pub configured_work_mem_bytes: usize,
+    pub configured_max_spill_bytes: usize,
+    pub configured_batch_rows: usize,
+    pub estimated_rows: usize,
+    pub estimated_row_width: usize,
+    pub operator: SqlOperatorClass,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct QueryMemoryStageDecision {
+    pub work_mem_bytes: usize,
+    pub max_spill_bytes: usize,
+    pub batch_rows: usize,
+}
+
+pub trait QueryMemoryStage: SqlStage {
+    fn choose_memory(&self, ctx: QueryMemoryStageContext) -> QueryMemoryStageDecision;
+
+    fn audit_query_memory(&self) -> SqlStageAuditResult {
+        self.audit()?;
+        let ctx = QueryMemoryStageContext {
+            configured_work_mem_bytes: 8 * 1024 * 1024,
+            configured_max_spill_bytes: 1024 * 1024 * 1024,
+            configured_batch_rows: 1024,
+            estimated_rows: 10_000,
+            estimated_row_width: 128,
+            operator: SqlOperatorClass::HashJoin,
+        };
+        let decision = self.choose_memory(ctx);
+        if decision.batch_rows == 0 || decision.batch_rows > 65_536 {
+            return Err(SqlStageAuditError {
+                family: SqlStageFamily::QueryMemory,
+                message: "batch rows must be nonzero and bounded",
+            });
+        }
+        if decision.work_mem_bytes == 0 || decision.work_mem_bytes > ctx.configured_work_mem_bytes {
+            return Err(SqlStageAuditError {
+                family: SqlStageFamily::QueryMemory,
+                message: "work memory must be within configured cap",
+            });
+        }
+        if decision.max_spill_bytes > ctx.configured_max_spill_bytes {
+            return Err(SqlStageAuditError {
+                family: SqlStageFamily::QueryMemory,
+                message: "spill cap must not exceed configuration",
+            });
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone)]
+pub struct SqlStageSet {
+    pub planner: Arc<dyn SqlPlannerStage>,
+    pub query_memory: Arc<dyn QueryMemoryStage>,
+}
+
+impl Default for SqlStageSet {
+    fn default() -> Self {
+        Self {
+            planner: Arc::new(DefaultSqlPlannerStage),
+            query_memory: Arc::new(DefaultQueryMemoryStage),
+        }
+    }
+}
+
+impl SqlStageSet {
+    pub fn audit(&self) -> SqlStageAuditResult {
+        self.planner.audit_planner()?;
+        self.query_memory.audit_query_memory()?;
+        Ok(())
+    }
+
+    pub fn manifests(&self) -> [SqlStageManifest; 2] {
+        [self.planner.manifest(), self.query_memory.manifest()]
+    }
+}
+
+pub struct DefaultSqlPlannerStage;
+
+impl SqlStage for DefaultSqlPlannerStage {
+    fn manifest(&self) -> SqlStageManifest {
+        SqlStageManifest {
+            family: SqlStageFamily::Planner,
+            name: "sql_planner_default",
+            version: 1,
+            deterministic: true,
+        }
+    }
+}
+
+impl SqlPlannerStage for DefaultSqlPlannerStage {
+    fn choose_join_kind(&self, ctx: JoinChoiceStageContext) -> SqlJoinStageKind {
+        if ctx.left_rows <= 16.0 || ctx.right_rows <= 16.0 {
+            return SqlJoinStageKind::NestedLoop;
+        }
+        if !ctx.has_selection {
+            return SqlJoinStageKind::Cross;
+        }
+        if ctx.has_indexable_equality && (ctx.left_rows <= 256.0 || ctx.right_rows <= 1024.0) {
+            return SqlJoinStageKind::IndexNestedLoop;
+        }
+        if ctx.has_equality {
+            return SqlJoinStageKind::Hash;
+        }
+        SqlJoinStageKind::NestedLoop
+    }
+
+    fn aggregate_kind(&self, ctx: AggregateChoiceStageContext) -> SqlAggregateStageKind {
+        if ctx.ordered {
+            SqlAggregateStageKind::Streaming
+        } else {
+            SqlAggregateStageKind::Hash
+        }
+    }
+
+    fn ordering_kind(&self, ctx: SortChoiceStageContext) -> SqlOrderingStageKind {
+        if ctx.limit.is_some_and(|limit| limit <= 64) {
+            SqlOrderingStageKind::TopN
+        } else {
+            SqlOrderingStageKind::Sort
+        }
+    }
+}
+
+pub struct DefaultQueryMemoryStage;
+
+impl SqlStage for DefaultQueryMemoryStage {
+    fn manifest(&self) -> SqlStageManifest {
+        SqlStageManifest {
+            family: SqlStageFamily::QueryMemory,
+            name: "query_memory_default",
+            version: 1,
+            deterministic: true,
+        }
+    }
+}
+
+impl QueryMemoryStage for DefaultQueryMemoryStage {
+    fn choose_memory(&self, ctx: QueryMemoryStageContext) -> QueryMemoryStageDecision {
+        QueryMemoryStageDecision {
+            work_mem_bytes: ctx.configured_work_mem_bytes.max(1),
+            max_spill_bytes: ctx.configured_max_spill_bytes,
+            batch_rows: ctx.configured_batch_rows.max(1),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn default_sql_stage_set_passes_audit() {
+        SqlStageSet::default().audit().expect("default SQL stages audit");
+    }
+
+    #[test]
+    fn default_sql_stage_set_has_unique_families() {
+        let manifests = SqlStageSet::default().manifests();
+        let mut families = manifests.iter().map(|m| m.family).collect::<Vec<_>>();
+        families.sort_by_key(|f| *f as u8);
+        families.dedup();
+        assert_eq!(families.len(), manifests.len());
+    }
+}
