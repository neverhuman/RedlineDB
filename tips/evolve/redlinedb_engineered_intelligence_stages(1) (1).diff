+++ b/crates/kernel/src/stages.rs
@@ -0,0 +1,183 @@
+//! Engineered-intelligence stage metadata.
+//!
+//! A stage is a small, correctness-bounded policy surface that can be swapped
+//! by changing the active implementation type alias in the owning module. This
+//! crate keeps stage metadata separate from the hot-path policy traits so the
+//! execution path remains statically dispatched and allocation-free.
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StageSafetyClass {
+    /// Pure choice surface. Implementations may change an algorithmic choice
+    /// but cannot directly mutate persistent state.
+    PurePolicy,
+    /// The call site must clamp or interpret the stage output before it can
+    /// affect durability, liveness, or concurrency semantics.
+    ClampedPolicy,
+    /// Reserved for future stages that directly own side effects. The initial
+    /// genome intentionally avoids these.
+    CriticalSideEffect,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StageFamily {
+    SqlPlanner,
+    WalSchedule,
+    HeapPlacement,
+    UndoRead,
+    IndexCursor,
+    LeafSplit,
+    CommitBarrier,
+    RowLock,
+    TransactionAdmission,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageDescriptor {
+    pub id: &'static str,
+    pub family: StageFamily,
+    pub version: u16,
+    pub safety: StageSafetyClass,
+    pub default_impl: &'static str,
+    pub invariants: &'static [&'static str],
+}
+
+/// Optional marker for concrete policy types that want to advertise their
+/// contract directly. Some current policy structs intentionally implement more
+/// than one stage family, so the manifest below remains the authoritative list.
+pub trait StageContract {
+    const DESCRIPTOR: StageDescriptor;
+}
+
+pub const WAL_SCHEDULE_INVARIANTS: &[&str] = &[
+    "write_batch_bytes(ctx) >= 1",
+    "drain_batch_bytes(ctx) >= 1",
+    "group_commit_delay_us(ctx) must not bypass the caller's durability barrier",
+    "resampling may widen a flush target only before the fsync that releases waiters",
+];
+
+pub const HEAP_PLACEMENT_INVARIANTS: &[&str] = &[
+    "row_lane(row_id, lanes) < lanes.max(1)",
+    "relation_lane(rel_id, lanes) < lanes.max(1)",
+    "reusable_page may only select between queued reusable pages and fresh allocation",
+    "the policy must not fabricate page ids or tuple pointers",
+];
+
+pub const UNDO_READ_INVARIANTS: &[&str] = &[
+    "prefetch_next is advisory only",
+    "depth_limit_hint is a safety hint, not a visibility decision",
+    "the policy must never decide tuple visibility directly",
+];
+
+pub const INDEX_CURSOR_INVARIANTS: &[&str] = &[
+    "cursor batch constants must be greater than zero",
+    "right-sibling prefetch is advisory only",
+    "stop_after_leaf must be monotonic with the end bound",
+    "visibility and residual predicates remain outside the policy",
+];
+
+pub const LEAF_SPLIT_INVARIANTS: &[&str] = &[
+    "split_point must be in 1..entries.len() for splittable pages",
+    "duplicate_mode must preserve logical key ordering",
+    "the policy must not reorder entries",
+];
+
+pub const COMMIT_BARRIER_INVARIANTS: &[&str] = &[
+    "Strict durability may not skip the WAL flush barrier",
+    "Normal durability may not skip WAL write acknowledgement",
+    "UnsafeDev is the only mode that may skip the barrier",
+    "schema or index side-effect commits may not publish before their barrier",
+];
+
+pub const ROW_LOCK_INVARIANTS: &[&str] = &[
+    "shard(ctx) must be clamped to an existing shard",
+    "the policy cannot grant or release ownership directly",
+    "timeout enforcement remains in RowLockManager",
+];
+
+pub const TRANSACTION_ADMISSION_INVARIANTS: &[&str] = &[
+    "unsupported isolation levels must be rejected",
+    "transaction ids and snapshots remain allocated by ConcurrentTxStatus",
+];
+
+pub const WAL_SCHEDULE_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.wal.schedule",
+    family: StageFamily::WalSchedule,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "WalScheduleDefault",
+    invariants: WAL_SCHEDULE_INVARIANTS,
+};
+
+pub const HEAP_PLACEMENT_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.heap.placement",
+    family: StageFamily::HeapPlacement,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "HeapModuloPolicy",
+    invariants: HEAP_PLACEMENT_INVARIANTS,
+};
+
+pub const UNDO_READ_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.heap.undo_read",
+    family: StageFamily::UndoRead,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "HeapModuloPolicy",
+    invariants: UNDO_READ_INVARIANTS,
+};
+
+pub const INDEX_CURSOR_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.index.cursor",
+    family: StageFamily::IndexCursor,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "IndexCurrentPolicy",
+    invariants: INDEX_CURSOR_INVARIANTS,
+};
+
+pub const LEAF_SPLIT_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.index.leaf_split",
+    family: StageFamily::LeafSplit,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "IndexCurrentPolicy",
+    invariants: LEAF_SPLIT_INVARIANTS,
+};
+
+pub const COMMIT_BARRIER_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.engine.commit_barrier",
+    family: StageFamily::CommitBarrier,
+    version: 1,
+    safety: StageSafetyClass::ClampedPolicy,
+    default_impl: "CommitBarrierCurrentPolicy",
+    invariants: COMMIT_BARRIER_INVARIANTS,
+};
+
+pub const ROW_LOCK_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.engine.row_lock",
+    family: StageFamily::RowLock,
+    version: 1,
+    safety: StageSafetyClass::ClampedPolicy,
+    default_impl: "RowLockCurrentPolicy",
+    invariants: ROW_LOCK_INVARIANTS,
+};
+
+pub const TRANSACTION_ADMISSION_STAGE: StageDescriptor = StageDescriptor {
+    id: "kernel.engine.transaction_admission",
+    family: StageFamily::TransactionAdmission,
+    version: 1,
+    safety: StageSafetyClass::ClampedPolicy,
+    default_impl: "TransactionAdmissionCurrentPolicy",
+    invariants: TRANSACTION_ADMISSION_INVARIANTS,
+};
+
+pub const KERNEL_STAGE_MANIFEST: &[StageDescriptor] = &[
+    WAL_SCHEDULE_STAGE,
+    HEAP_PLACEMENT_STAGE,
+    UNDO_READ_STAGE,
+    INDEX_CURSOR_STAGE,
+    LEAF_SPLIT_STAGE,
+    COMMIT_BARRIER_STAGE,
+    ROW_LOCK_STAGE,
+    TRANSACTION_ADMISSION_STAGE,
+];

