+//! SQL-layer stage metadata.
+//!
+//! The SQL crate owns planner/executor policy stages. Kernel stages live in
+//! `redlinedb_kernel::stages`; this module gives genome tooling one public
+//! SQL-side manifest without exposing planner internals as a public API.
+
+pub use redlinedb_kernel::stages::{StageDescriptor, StageFamily, StageSafetyClass};
+
+pub const SQL_PLANNER_INVARIANTS: &[&str] = &[
+    "join choice must be one supported JoinKind",
+    "aggregate choice must be StreamingAggregate or HashAggregate",
+    "ordering choice must be Sort or TopN",
+    "planner policies must not remove residual predicates",
+];
+
+pub const SQL_PLANNER_STAGE: StageDescriptor = StageDescriptor {
+    id: "sql.planner.choice",
+    family: StageFamily::SqlPlanner,
+    version: 1,
+    safety: StageSafetyClass::PurePolicy,
+    default_impl: "SqlCurrentPolicy",
+    invariants: SQL_PLANNER_INVARIANTS,
+};
+
+pub const SQL_STAGE_MANIFEST: &[StageDescriptor] = &[SQL_PLANNER_STAGE];

