diff --git a/crates/kernel/src/engine/policy.rs b/crates/kernel/src/engine/policy.rs
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/crates/kernel/src/engine/policy.rs
@@ -0,0 +1,237 @@
+#![allow(dead_code)]
+
+use std::hash::{Hash, Hasher};
+
+use crate::engine::CommitDurability;
+use crate::format::{Lsn, RelId, RowId};
+use crate::stages::{StageContract, StageDescriptor, StageFamily, StageSafetyClass};
+use crate::txn::Isolation;
+use crate::{Error, Result};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct BeginAdmissionContext {
+    pub isolation: Isolation,
+}
+
+pub(crate) trait TransactionAdmissionPolicy {
+    fn admit_begin(ctx: BeginAdmissionContext) -> Result<()>;
+}
+
+pub(crate) type ActiveTransactionAdmissionPolicy = TransactionAdmissionCurrentPolicy;
+
+pub(crate) struct TransactionAdmissionCurrentPolicy;
+
+impl TransactionAdmissionPolicy for TransactionAdmissionCurrentPolicy {
+    fn admit_begin(ctx: BeginAdmissionContext) -> Result<()> {
+        if ctx.isolation == Isolation::Serializable {
+            Err(Error::UnsupportedIsolation)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+impl StageContract for TransactionAdmissionCurrentPolicy {
+    const DESCRIPTOR: StageDescriptor = crate::stages::TRANSACTION_ADMISSION_STAGE;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum CommitBarrierAction {
+    Flush,
+    Write,
+    Skip,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct CommitBarrierContext {
+    pub durability: CommitDurability,
+    pub end_lsn: Lsn,
+    pub has_catalog_side_effects: bool,
+    pub has_index_side_effects: bool,
+}
+
+impl CommitBarrierContext {
+    pub fn has_side_effects(self) -> bool {
+        self.has_catalog_side_effects || self.has_index_side_effects
+    }
+}
+
+pub(crate) trait CommitBarrierPolicy {
+    fn may_publish_before_barrier(ctx: CommitBarrierContext) -> bool;
+    fn barrier_action(ctx: CommitBarrierContext) -> CommitBarrierAction;
+
+    fn flush_wal_on_shutdown(durability: CommitDurability) -> bool {
+        !matches!(durability, CommitDurability::UnsafeDev)
+    }
+
+    fn catalog_sync_is_durable(durability: CommitDurability) -> bool {
+        !matches!(durability, CommitDurability::UnsafeDev)
+    }
+}
+
+pub(crate) type ActiveCommitBarrierPolicy = CommitBarrierCurrentPolicy;
+
+pub(crate) struct CommitBarrierCurrentPolicy;
+
+impl CommitBarrierPolicy for CommitBarrierCurrentPolicy {
+    fn may_publish_before_barrier(ctx: CommitBarrierContext) -> bool {
+        ctx.durability == CommitDurability::Strict && !ctx.has_side_effects()
+    }
+
+    fn barrier_action(ctx: CommitBarrierContext) -> CommitBarrierAction {
+        match ctx.durability {
+            CommitDurability::Strict => CommitBarrierAction::Flush,
+            CommitDurability::Normal => CommitBarrierAction::Write,
+            CommitDurability::UnsafeDev => CommitBarrierAction::Skip,
+        }
+    }
+}
+
+impl StageContract for CommitBarrierCurrentPolicy {
+    const DESCRIPTOR: StageDescriptor = crate::stages::COMMIT_BARRIER_STAGE;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct RowLockShardContext {
+    pub rel_id: RelId,
+    pub row_id: RowId,
+    pub shard_count: usize,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum RowLockWake {
+    Front,
+    Broadcast,
+}
+
+pub(crate) trait RowLockPolicy {
+    fn shard(ctx: RowLockShardContext) -> usize;
+    fn unlock_wake() -> RowLockWake;
+}
+
+pub(crate) type ActiveRowLockPolicy = RowLockCurrentPolicy;
+
+pub(crate) struct RowLockCurrentPolicy;
+
+impl RowLockPolicy for RowLockCurrentPolicy {
+    fn shard(ctx: RowLockShardContext) -> usize {
+        let shard_count = ctx.shard_count.max(1);
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        ctx.rel_id.hash(&mut hasher);
+        ctx.row_id.hash(&mut hasher);
+        hasher.finish() as usize % shard_count
+    }
+
+    fn unlock_wake() -> RowLockWake {
+        RowLockWake::Front
+    }
+}
+
+impl StageContract for RowLockCurrentPolicy {
+    const DESCRIPTOR: StageDescriptor = crate::stages::ROW_LOCK_STAGE;
+}
+
+pub(crate) struct RowLockRelationBiasedPolicy;
+
+impl RowLockPolicy for RowLockRelationBiasedPolicy {
+    fn shard(ctx: RowLockShardContext) -> usize {
+        let shard_count = ctx.shard_count.max(1);
+        let mut x = ctx.rel_id.0.rotate_left(17) ^ ctx.row_id.0;
+        x ^= x >> 33;
+        x = x.wrapping_mul(0xff51afd7ed558ccd);
+        x ^= x >> 33;
+        x as usize % shard_count
+    }
+
+    fn unlock_wake() -> RowLockWake {
+        RowLockWake::Front
+    }
+}
+
+pub(crate) struct RowLockBroadcastPolicy;
+
+impl RowLockPolicy for RowLockBroadcastPolicy {
+    fn shard(ctx: RowLockShardContext) -> usize {
+        RowLockCurrentPolicy::shard(ctx)
+    }
+
+    fn unlock_wake() -> RowLockWake {
+        RowLockWake::Broadcast
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::format::{Lsn, RelId, RowId};
+
+    fn audit_row_lock<P: RowLockPolicy>() {
+        let shard = P::shard(RowLockShardContext {
+            rel_id: RelId(7),
+            row_id: RowId(11),
+            shard_count: 8,
+        });
+        assert!(shard < 8);
+        assert!(matches!(P::unlock_wake(), RowLockWake::Front | RowLockWake::Broadcast));
+    }
+
+    #[test]
+    fn row_lock_policy_drop_ins_preserve_basic_invariants() {
+        audit_row_lock::<RowLockCurrentPolicy>();
+        audit_row_lock::<RowLockRelationBiasedPolicy>();
+        audit_row_lock::<RowLockBroadcastPolicy>();
+    }
+
+    #[test]
+    fn commit_barrier_current_policy_preserves_durability_modes() {
+        let strict = CommitBarrierContext {
+            durability: CommitDurability::Strict,
+            end_lsn: Lsn(10),
+            has_catalog_side_effects: false,
+            has_index_side_effects: false,
+        };
+        assert_eq!(
+            CommitBarrierCurrentPolicy::barrier_action(strict),
+            CommitBarrierAction::Flush
+        );
+        assert!(CommitBarrierCurrentPolicy::may_publish_before_barrier(strict));
+
+        let strict_with_schema = CommitBarrierContext {
+            has_catalog_side_effects: true,
+            ..strict
+        };
+        assert!(!CommitBarrierCurrentPolicy::may_publish_before_barrier(strict_with_schema));
+
+        let normal = CommitBarrierContext {
+            durability: CommitDurability::Normal,
+            ..strict
+        };
+        assert_eq!(
+            CommitBarrierCurrentPolicy::barrier_action(normal),
+            CommitBarrierAction::Write
+        );
+
+        let unsafe_dev = CommitBarrierContext {
+            durability: CommitDurability::UnsafeDev,
+            ..strict
+        };
+        assert_eq!(
+            CommitBarrierCurrentPolicy::barrier_action(unsafe_dev),
+            CommitBarrierAction::Skip
+        );
+    }
+
+    #[test]
+    fn transaction_admission_current_policy_rejects_serializable() {
+        assert!(TransactionAdmissionCurrentPolicy::admit_begin(BeginAdmissionContext {
+            isolation: Isolation::ReadCommitted,
+        })
+        .is_ok());
+        assert!(matches!(
+            TransactionAdmissionCurrentPolicy::admit_begin(BeginAdmissionContext {
+                isolation: Isolation::Serializable,
+            }),
+            Err(Error::UnsupportedIsolation)
+        ));
+    }
+}

