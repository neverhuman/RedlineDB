+fn write_readfile_hex_path<W: Write>(path: &std::path::Path, out: &mut W) -> Result<(), String> {
+    let file = std::fs::File::open(path)
+        .map_err(|err| format!("cannot read {}: {err}", path.display()))?;
+    let mut reader = io::BufReader::with_capacity(READFILE_HEX_INPUT_BYTES, file);
+    let mut input = [0u8; READFILE_HEX_INPUT_BYTES];
+    let mut encoded = [0u8; READFILE_HEX_OUTPUT_BYTES];
+    loop {
+        let n = reader.read(&mut input).map_err(|err| err.to_string())?;
+        if n == 0 {
+            break;
+        }
+        for (idx, byte) in input[..n].iter().copied().enumerate() {
+            encoded[idx * 2] = HEX_UPPER[(byte >> 4) as usize];
+            encoded[idx * 2 + 1] = HEX_UPPER[(byte & 0x0f) as usize];
+        }
+        out.write_all(&encoded[..n * 2])
+            .map_err(|err| err.to_string())?;
+    }
+    Ok(())
+}
+
+fn try_fast_cli_argv_select(
+    cli: &Cli,
+    filename: &str,
+    mode: OutputMode,
+    separator: &str,
+    show_header: bool,
+    null_value: Option<&str>,
+    row_separator: Option<&str>,
+) -> Result<bool, String> {
+    if cli.sql.is_empty() || !fast_cli_common_eligible(cli) || !fast_render_mode_supported(mode) {
+        return Ok(false);
+    }
+    let sql = cli.sql.join("\n");
+    if !fast_select_supported(&sql) {
+        return Ok(false);
+    }
+    touch_fast_cli_database_file(filename)?;
+    let mut state = FastCliState::new(
+        mode,
+        separator.to_owned(),
+        show_header,
+        null_value.unwrap_or("").to_owned(),
+        row_separator.unwrap_or("\n").to_owned(),
+    );
+    state.run_fast_select(&sql)?;
+    state.flush()?;
+    Ok(true)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn try_fast_cli_script(
+    cli: &Cli,
+    filename: &str,
+    input: &str,
+    mode: OutputMode,
+    separator: &str,
+    show_header: bool,
+    null_value: Option<&str>,
+    row_separator: Option<&str>,
+) -> Result<bool, String> {
+    if filename != ":memory:" || !fast_cli_common_eligible(cli) || !fast_render_mode_supported(mode) {
+        return Ok(false);
+    }
+    if !fast_cli_script_supported(input, 0)? {
+        return Ok(false);
+    }
+    let mut state = FastCliState::new(
+        mode,
+        separator.to_owned(),
+        show_header,
+        null_value.unwrap_or("").to_owned(),
+        row_separator.unwrap_or("\n").to_owned(),
+    );
+    state.run_script(input, 0)?;
+    state.flush()?;
+    Ok(true)
+}
+
+fn fast_render_mode_supported(mode: OutputMode) -> bool {
+    matches!(mode, OutputMode::List | OutputMode::Csv | OutputMode::Tabs)
+}
+
+fn fast_cli_common_eligible(cli: &Cli) -> bool {
+    cli.cmd.is_empty()
+        && cli.init.is_none()
+        && !cli.readonly
+        && !cli.deserialize
+        && !cli.safe
+        && !cli.stats
+        && !cli.memtrace
+        && !cli.pcachetrace
+        && !cli.vfstrace
+        && !cli.unsafe_testing
+        && !cli.interactive
+}
+
+fn touch_fast_cli_database_file(filename: &str) -> Result<(), String> {
+    if filename == ":memory:" || filename.is_empty() {
+        return Ok(());
+    }
+    let _file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .open(filename)
+        .map_err(|err| format!("Error: unable to open database \"{filename}\": {err}"))?;
+    Ok(())
+}
+
+fn fast_cli_script_supported(input: &str, depth: usize) -> Result<bool, String> {
+    if depth > 8 {
+        return Ok(false);
+    }
+    for raw_line in input.lines() {
+        let line = raw_line.trim();
+        if line.is_empty() {
+            continue;
+        }
+        if line.starts_with('.') {
+            let parts = dot::split_args(line);
+            let Some((cmd, args)) = parts.split_first() else {
+                return Ok(false);
+            };
+            match cmd.as_str() {
+                ".mode" => {
+                    if args.len() != 1 {
+                        return Ok(false);
+                    }
+                    let Some(mode) = OutputMode::parse(&args[0]) else {
+                        return Ok(false);
+                    };
+                    if !fast_render_mode_supported(mode) {
+                        return Ok(false);
+                    }
+                }
+                ".headers" | ".header" => {
+                    if args.len() != 1 || !matches!(args[0].as_str(), "on" | "off" | "1" | "0") {
+                        return Ok(false);
+                    }
+                }
+                ".separator" | ".nullvalue" | ".cd" | ".once" => {
+                    if args.len() != 1 {
+                        return Ok(false);
+                    }
+                }
+                ".output" => {
+                    if args.len() > 1 {
+                        return Ok(false);
+                    }
+                }
+                ".print" => {}
+                ".read" => {
+                    if args.len() != 1 {
+                        return Ok(false);
+                    }
+                    let contents = fs::read_to_string(&args[0])
+                        .map_err(|err| format!("Error: cannot read {}: {err}", args[0]))?;
+                    if !fast_cli_script_supported(&contents, depth + 1)? {
+                        return Ok(false);
+                    }
+                }
+                _ => return Ok(false),
+            }
+        } else if !fast_select_supported(line) {
+            return Ok(false);
+        }
+    }
+    Ok(true)
+}
+
+fn fast_select_supported(sql: &str) -> bool {
+    parse_integer_select(sql).is_some() || parse_readfile_hex_query(sql).is_some()
+}
+
+fn parse_integer_select(sql: &str) -> Option<i64> {
+    let trimmed = sql.trim().trim_end_matches(';').trim();
+    let lower = trimmed.to_ascii_lowercase();
+    let body = lower.strip_prefix("select ")?.trim();
+    if body.contains(" from ") || body.contains(',') || body.contains('(') {
+        return None;
+    }
+    body.parse::<i64>().ok()
+}
+
+struct FastCliState {
+    mode: OutputMode,
+    separator: String,
+    row_separator: String,
+    show_header: bool,
+    null_value: String,
+    output: FastOutput,
+    once: Option<PathBuf>,
+}
+
+impl FastCliState {
+    fn new(
+        mode: OutputMode,
+        separator: String,
+        show_header: bool,
+        null_value: String,
+        row_separator: String,
+    ) -> Self {
+        Self {
+            mode,
+            separator,
+            row_separator,
+            show_header,
+            null_value,
+            output: FastOutput::stdout(),
+            once: None,
+        }
+    }
+
+    fn flush(&mut self) -> Result<(), String> {
+        self.output.flush().map_err(|err| err.to_string())
+    }
+
+    fn run_script(&mut self, input: &str, depth: usize) -> Result<(), String> {
+        if depth > 8 {
+            return Err("Error: .read nesting limit exceeded".to_owned());
+        }
+        for raw_line in input.lines() {
+            let line = raw_line.trim();
+            if line.is_empty() {
+                continue;
+            }
+            if line.starts_with('.') {
+                self.run_dot(line, depth)?;
+            } else {
+                self.run_fast_select(line)?;
+            }
+        }
+        Ok(())
+    }
+
+    fn run_dot(&mut self, line: &str, depth: usize) -> Result<(), String> {
+        let parts = dot::split_args(line);
+        let Some((cmd, args)) = parts.split_first() else {
+            return Ok(());
+        };
+        match cmd.as_str() {
+            ".mode" => {
+                let mode = OutputMode::parse(&args[0])
+                    .ok_or_else(|| format!("Error: mode should be one of list/csv/tabs: {}", args[0]))?;
+                self.mode = mode;
+                self.separator = mode.default_separator().to_owned();
+                self.show_header = mode.headers_by_default();
+            }
+            ".headers" | ".header" => {
+                self.show_header = matches!(args[0].as_str(), "on" | "1");
+            }
+            ".separator" => self.separator = args[0].clone(),
+            ".nullvalue" => self.null_value = args[0].clone(),
+            ".cd" => std::env::set_current_dir(&args[0])
+                .map_err(|err| format!("Error: cannot cd to {}: {err}", args[0]))?,
+            ".print" => {
+                let line = args.join(" ");
+                self.output
+                    .write_all(line.as_bytes())
+                    .map_err(|err| err.to_string())?;
+                self.output.write_all(b"\n").map_err(|err| err.to_string())?;
+            }
+            ".output" => {
+                self.output.flush().map_err(|err| err.to_string())?;
+                match args.first().map(String::as_str) {
+                    None | Some("stdout") => self.output = FastOutput::stdout(),
+                    Some("off") => self.output = FastOutput::Null,
+                    Some(path) => self.output = FastOutput::file(PathBuf::from(path))?,
+                }
+            }
+            ".once" => self.once = Some(PathBuf::from(&args[0])),
+            ".read" => {
+                let path = PathBuf::from(&args[0]);
+                let contents = fs::read_to_string(&path)
+                    .map_err(|err| format!("Error: cannot read {}: {err}", path.display()))?;
+                self.run_script(&contents, depth + 1)?;
+            }
+            _ => return Err(format!("Error: unsupported fast command {cmd}")),
+        }
+        Ok(())
+    }
+
+    fn run_fast_select(&mut self, sql: &str) -> Result<(), String> {
+        let mode = self.mode;
+        let separator = self.separator.clone();
+        let row_separator = self.row_separator.clone();
+        let show_header = self.show_header;
+        let null_value = self.null_value.clone();
+        let opts = FastRenderOptions {
+            mode,
+            separator,
+            row_separator,
+            show_header,
+            null_value,
+        };
+        if let Some(path) = self.once.take() {
+            let file = std::fs::File::create(&path)
+                .map_err(|err| format!("Error: cannot open {}: {err}", path.display()))?;
+            let mut writer = io::BufWriter::with_capacity(FAST_FILE_OUTPUT_BUFFER_BYTES, file);
+            write_fast_select_to(sql, &mut writer, &opts)?;
+            writer.flush().map_err(|err| err.to_string())
+        } else {
+            write_fast_select_to(sql, &mut self.output, &opts)
+        }
+    }
+}
+
+struct FastRenderOptions {
+    mode: OutputMode,
+    separator: String,
+    row_separator: String,
+    show_header: bool,
+    null_value: String,
+}
+
+fn write_fast_select_to<W: Write>(
+    sql: &str,
+    out: &mut W,
+    opts: &FastRenderOptions,
+) -> Result<(), String> {
+    if let Some(value) = parse_integer_select(sql) {
+        let value = value.to_string();
+        if opts.show_header {
+            write_fast_scalar(out, &value, &opts.row_separator, opts.mode)?;
+        }
+        write_fast_scalar(out, &value, &opts.row_separator, opts.mode)
+    } else if let Some(path) = parse_readfile_hex_query(sql) {
+        if opts.show_header {
+            write_fast_scalar(out, "hex(readfile())", &opts.row_separator, opts.mode)?;
+        }
+        write_readfile_hex_path(&path, out)?;
+        write_row_separator(out, row_terminator(opts.mode, &opts.row_separator))
+    } else {
+        Err("Error: unsupported fast SELECT".to_owned())
+    }
+}
+
+fn write_fast_scalar<W: Write>(
+    out: &mut W,
+    value: &str,
+    row_separator: &str,
+    mode: OutputMode,
+) -> Result<(), String> {
+    out.write_all(value.as_bytes()).map_err(|err| err.to_string())?;
+    write_row_separator(out, row_terminator(mode, row_separator))
+}
+
+fn row_terminator<'a>(mode: OutputMode, row_separator: &'a str) -> &'a str {
+    if matches!(mode, OutputMode::Csv) {
+        "\r\n"
+    } else {
+        row_separator
+    }
+}
+
+enum FastOutput {
+    Stdout(io::BufWriter<io::Stdout>),
+    File(io::BufWriter<std::fs::File>),
+    Null,
+}
+
+impl FastOutput {
+    fn stdout() -> Self {
+        Self::Stdout(io::BufWriter::new(io::stdout()))
+    }
+
+    fn file(path: PathBuf) -> Result<Self, String> {
+        let file = std::fs::OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(&path)
+            .map_err(|err| format!("Error: cannot open {}: {err}", path.display()))?;
+        Ok(Self::File(io::BufWriter::with_capacity(
+            FAST_FILE_OUTPUT_BUFFER_BYTES,
+            file,
+        )))
+    }
+}
+
+impl Write for FastOutput {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        match self {
+            Self::Stdout(writer) => writer.write(buf),
+            Self::File(writer) => writer.write(buf),
+            Self::Null => Ok(buf.len()),
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        match self {
+            Self::Stdout(writer) => writer.flush(),
+            Self::File(writer) => writer.flush(),
+            Self::Null => Ok(()),
+        }
+    }
+}
