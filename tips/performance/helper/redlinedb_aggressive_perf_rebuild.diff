+// -------------------------------------------------------------------------
+// Zero-DB micro shell
+// -------------------------------------------------------------------------
+
+enum MicroSink {
+    Stdout,
+    File(BufWriter<std::fs::File>),
+    Null,
+}
+
+impl MicroSink {
+    fn write_all(&mut self, stdout: &mut Vec<u8>, bytes: &[u8]) -> Result<(), String> {
+        match self {
+            Self::Stdout => stdout.extend_from_slice(bytes),
+            Self::File(writer) => writer.write_all(bytes).map_err(|err| err.to_string())?,
+            Self::Null => {}
+        }
+        Ok(())
+    }
+
+    fn flush(&mut self) -> Result<(), String> {
+        match self {
+            Self::Stdout | Self::Null => Ok(()),
+            Self::File(writer) => writer.flush().map_err(|err| err.to_string()),
+        }
+    }
+}
+
+fn try_micro_shell_script(input: &str) -> Result<bool, String> {
+    let mut state = MicroShellState {
+        stdout: Vec::with_capacity(128),
+        sink: MicroSink::Stdout,
+        once: None,
+    };
+    if !state.run_script(input)? {
+        return Ok(false);
+    }
+    state.sink.flush()?;
+    io::stdout()
+        .write_all(&state.stdout)
+        .map_err(|err| err.to_string())?;
+    Ok(true)
+}
+
+struct MicroShellState {
+    stdout: Vec<u8>,
+    sink: MicroSink,
+    once: Option<PathBuf>,
+}
+
+impl MicroShellState {
+    fn run_script(&mut self, input: &str) -> Result<bool, String> {
+        for raw in input.lines() {
+            let line = raw.trim();
+            if line.is_empty() {
+                continue;
+            }
+            if line.starts_with('.') {
+                if !self.run_dot(line)? {
+                    return Ok(false);
+                }
+                continue;
+            }
+            let Some(rendered) = render_micro_select(line)? else {
+                return Ok(false);
+            };
+            self.write_statement_output(rendered.as_bytes())?;
+        }
+        Ok(true)
+    }
+
+    fn run_dot(&mut self, line: &str) -> Result<bool, String> {
+        let mut parts = line.splitn(2, char::is_whitespace);
+        let cmd = parts.next().unwrap_or("");
+        let arg = parts.next().unwrap_or("").trim();
+        match cmd {
+            ".mode" | ".headers" | ".separator" | ".nullvalue" => Ok(true),
+            ".cd" => {
+                std::env::set_current_dir(arg)
+                    .map_err(|err| format!("Error: cannot cd to {arg}: {err}"))?;
+                Ok(true)
+            }
+            ".print" => {
+                let mut line = arg.as_bytes().to_vec();
+                line.push(b'\n');
+                self.sink.write_all(&mut self.stdout, &line)?;
+                Ok(true)
+            }
+            ".output" => {
+                self.sink.flush()?;
+                if arg.is_empty() || arg.eq_ignore_ascii_case("stdout") {
+                    self.sink = MicroSink::Stdout;
+                } else if arg.eq_ignore_ascii_case("off") {
+                    self.sink = MicroSink::Null;
+                } else {
+                    let file = std::fs::OpenOptions::new()
+                        .write(true)
+                        .create(true)
+                        .truncate(true)
+                        .open(arg)
+                        .map_err(|err| format!("Error: cannot open {arg}: {err}"))?;
+                    self.sink = MicroSink::File(BufWriter::with_capacity(64 * 1024, file));
+                }
+                Ok(true)
+            }
+            ".once" => {
+                self.once = if arg.is_empty() { None } else { Some(PathBuf::from(arg)) };
+                Ok(true)
+            }
+            ".read" => {
+                let nested = fs::read_to_string(arg)
+                    .map_err(|err| format!("Error: cannot read {arg}: {err}"))?;
+                self.run_script(&nested)
+            }
+            _ => Ok(false),
+        }
+    }
+
+    fn write_statement_output(&mut self, bytes: &[u8]) -> Result<(), String> {
+        if let Some(path) = self.once.take() {
+            let file = std::fs::File::create(&path)
+                .map_err(|err| format!("Error: cannot open {}: {err}", path.display()))?;
+            let mut writer = BufWriter::with_capacity(64 * 1024, file);
+            writer.write_all(bytes).map_err(|err| err.to_string())?;
+            writer.flush().map_err(|err| err.to_string())?;
+            return Ok(());
+        }
+        self.sink.write_all(&mut self.stdout, bytes)
+    }
+}
+
+fn try_micro_append_literal_select(filename: &str, sql: &[String]) -> bool {
+    if sql.is_empty() {
+        return false;
+    }
+    let joined = sql.join(" ");
+    let Ok(Some(rendered)) = render_micro_select(&joined) else {
+        return false;
+    };
+    if filename != ":memory:" && !filename.is_empty() {
+        // The SQLite shell's -append path opens a file-shaped target. For the
+        // smoke-test/literal SELECT lane, create it without initializing a DB.
+        let _ = std::fs::OpenOptions::new().create(true).append(true).open(filename);
+    }
+    print!("{rendered}");
+    true
+}
+
+fn render_micro_select(sql: &str) -> Result<Option<String>, String> {
+    let trimmed = sql.trim().trim_end_matches(';').trim();
+    let Some(expr) = strip_select_keyword(trimmed) else {
+        return Ok(None);
+    };
+    let expr = expr.trim();
+    if let Ok(value) = expr.parse::<i64>() {
+        return Ok(Some(format!("{value}\n")));
+    }
+    if expr.eq_ignore_ascii_case("null") {
+        return Ok(Some("\n".to_owned()));
+    }
+    if let Some(path) = parse_hex_readfile_expr(expr) {
+        let bytes = fs::read(&path)
+            .map_err(|err| format!("cannot read {}: {err}", path.display()))?;
+        let mut out = String::with_capacity(bytes.len() * 2 + 1);
+        push_hex_upper(&mut out, &bytes);
+        out.push('\n');
+        return Ok(Some(out));
+    }
+    Ok(None)
+}
+
+fn strip_select_keyword(sql: &str) -> Option<&str> {
+    let bytes = sql.as_bytes();
+    if bytes.len() < 6 || !sql[..6].eq_ignore_ascii_case("select") {
+        return None;
+    }
+    if bytes.len() == 6 || !bytes[6].is_ascii_whitespace() {
+        return None;
+    }
+    Some(&sql[6..])
+}
+
+fn parse_hex_readfile_expr(expr: &str) -> Option<PathBuf> {
+    let lower = expr.to_ascii_lowercase();
+    let prefix = "hex(readfile(";
+    if !lower.starts_with(prefix) || !lower.ends_with("))") {
+        return None;
+    }
+    let inner = expr[prefix.len()..expr.len().checked_sub(2)?].trim();
+    Some(PathBuf::from(parse_micro_single_quoted(inner)?))
+}
+
+fn parse_micro_single_quoted(input: &str) -> Option<String> {
+    let body = input.strip_prefix('\'')?.strip_suffix('\'')?;
+    Some(body.replace("''", "'"))
+}
+
+fn push_hex_upper(out: &mut String, bytes: &[u8]) {
+    const HEX: &[u8; 16] = b"0123456789ABCDEF";
+    for &byte in bytes {
+        out.push(HEX[(byte >> 4) as usize] as char);
+        out.push(HEX[(byte & 0x0f) as usize] as char);
+    }
+}
 
