+const SHELL_ONLY_READ_DEPTH_LIMIT: usize = 16;
+
+fn shell_only_fast_path_candidate(cli: &Cli, preloaded_stdin: Option<&str>) -> Option<String> {
+    if cli.init.is_some() || !cli.cmd.is_empty() {
+        return None;
+    }
+    if !cli.sql.is_empty() {
+        return Some(cli.sql.join("\n"));
+    }
+    preloaded_stdin.map(str::to_owned)
+}
+
+fn shell_only_input_supported(input: &str, depth: usize) -> Result<bool, String> {
+    if depth > SHELL_ONLY_READ_DEPTH_LIMIT {
+        return Err("Error: .read nesting is too deep".to_owned());
+    }
+
+    let mut saw_command = false;
+    for raw_line in input.lines() {
+        let trimmed = raw_line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        if !trimmed.starts_with('.') {
+            return Ok(false);
+        }
+        let parts = dot::split_args(trimmed);
+        let Some((cmd, args)) = parts.split_first() else {
+            continue;
+        };
+        saw_command = true;
+        match cmd.as_str() {
+            ".cd" => {
+                if args.len() != 1 {
+                    return Ok(false);
+                }
+            }
+            ".output" | ".once" => {
+                if args.len() > 1 {
+                    return Ok(false);
+                }
+            }
+            ".print" => {}
+            ".read" => {
+                if args.len() != 1 {
+                    return Ok(false);
+                }
+                let Ok(contents) = fs::read_to_string(&args[0]) else {
+                    return Ok(false);
+                };
+                if !shell_only_input_supported(&contents, depth + 1)? {
+                    return Ok(false);
+                }
+            }
+            ".bail" | ".echo" | ".timer" | ".changes" | ".stats" | ".eqp"
+            | ".explain" | ".headers" | ".header" | ".mode" | ".separator"
+            | ".nullvalue" | ".crlf" | ".exit" | ".quit" => {}
+            _ => return Ok(false),
+        }
+    }
+    Ok(saw_command)
+}
+
+enum ShellFastOutput {
+    Stdout(io::BufWriter<io::Stdout>),
+    Null,
+    File(io::BufWriter<fs::File>),
+}
+
+impl ShellFastOutput {
+    fn stdout() -> Self {
+        Self::Stdout(io::BufWriter::new(io::stdout()))
+    }
+
+    fn write_all(&mut self, bytes: &[u8]) -> io::Result<()> {
+        match self {
+            Self::Stdout(writer) => writer.write_all(bytes),
+            Self::Null => Ok(()),
+            Self::File(writer) => writer.write_all(bytes),
+        }
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        match self {
+            Self::Stdout(writer) => writer.flush(),
+            Self::Null => Ok(()),
+            Self::File(writer) => writer.flush(),
+        }
+    }
+}
+
+struct ShellFastState {
+    output: ShellFastOutput,
+    append: bool,
+    bail: bool,
+    echo: bool,
+    row_separator: String,
+}
+
+impl ShellFastState {
+    fn new(append: bool) -> Self {
+        Self {
+            output: ShellFastOutput::stdout(),
+            append,
+            bail: false,
+            echo: false,
+            row_separator: "\n".to_owned(),
+        }
+    }
+
+    fn flush(&mut self) -> Result<(), String> {
+        self.output.flush().map_err(|err| err.to_string())
+    }
+
+    fn write_line(&mut self, line: &str) -> Result<(), String> {
+        self.output
+            .write_all(line.as_bytes())
+            .map_err(|err| err.to_string())?;
+        self.output
+            .write_all(self.row_separator.as_bytes())
+            .map_err(|err| err.to_string())
+    }
+
+    fn set_output(&mut self, args: &[String]) -> Result<(), String> {
+        self.flush()?;
+        match args.first().map(String::as_str) {
+            None | Some("stdout") => self.output = ShellFastOutput::stdout(),
+            Some("off") => self.output = ShellFastOutput::Null,
+            Some(path) => {
+                let mut opts = fs::OpenOptions::new();
+                opts.create(true).write(true);
+                if self.append {
+                    opts.append(true);
+                } else {
+                    opts.truncate(true);
+                }
+                let file = opts
+                    .open(path)
+                    .map_err(|err| format!("Error: cannot open {path}: {err}"))?;
+                self.output = ShellFastOutput::File(io::BufWriter::new(file));
+            }
+        }
+        Ok(())
+    }
+}
+
+fn run_shell_only_fast_path(
+    input: &str,
+    append: bool,
+    depth: usize,
+) -> Result<Option<i32>, String> {
+    let mut state = ShellFastState::new(append);
+    let exit_code = run_shell_only_fast_path_inner(&mut state, input, depth)?;
+    state.flush()?;
+    Ok(exit_code)
+}
+
+fn run_shell_only_fast_path_inner(
+    state: &mut ShellFastState,
+    input: &str,
+    depth: usize,
+) -> Result<Option<i32>, String> {
+    if depth > SHELL_ONLY_READ_DEPTH_LIMIT {
+        return Err("Error: .read nesting is too deep".to_owned());
+    }
+
+    for raw_line in input.lines() {
+        let trimmed = raw_line.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        if state.echo {
+            state.write_line(raw_line.trim_end())?;
+        }
+
+        let parts = dot::split_args(trimmed);
+        let Some((cmd, args)) = parts.split_first() else {
+            continue;
+        };
+        match cmd.as_str() {
+            ".cd" => {
+                let Some(path) = args.first() else {
+                    return Err("Error: usage: .cd DIRECTORY".to_owned());
+                };
+                std::env::set_current_dir(path)
+                    .map_err(|err| format!("Error: cannot cd to {path}: {err}"))?;
+            }
+            ".output" => state.set_output(args)?,
+            ".once" => {
+                // `.once` only redirects the next SQL statement. In a proven
+                // shell-only input there is no SQL statement, so there is no
+                // observable side effect beyond argument validation.
+            }
+            ".print" => state.write_line(&args.join(" "))?,
+            ".read" => {
+                let Some(path) = args.first() else {
+                    return Err("Error: usage: .read FILENAME".to_owned());
+                };
+                let contents = fs::read_to_string(path)
+                    .map_err(|err| format!("Error: cannot read {path}: {err}"))?;
+                if let Some(code) = run_shell_only_fast_path_inner(state, &contents, depth + 1)? {
+                    return Ok(Some(code));
+                }
+            }
+            ".bail" => {
+                if let Some(value) = args.first() {
+                    state.bail = matches!(value.to_ascii_lowercase().as_str(), "on" | "1" | "yes");
+                }
+            }
+            ".echo" => {
+                if let Some(value) = args.first() {
+                    state.echo = matches!(value.to_ascii_lowercase().as_str(), "on" | "1" | "yes");
+                }
+            }
+            ".crlf" => {
+                if let Some(value) = args.first() {
+                    state.row_separator = if matches!(
+                        value.to_ascii_lowercase().as_str(),
+                        "on" | "1" | "yes"
+                    ) {
+                        "\r\n".to_owned()
+                    } else {
+                        "\n".to_owned()
+                    };
+                }
+            }
+            ".timer" | ".changes" | ".stats" | ".eqp" | ".explain" | ".headers"
+            | ".header" | ".mode" | ".separator" | ".nullvalue" => {
+                // These mutate shell-local display state only. The fast path
+                // deliberately keeps just the subset that is observable by the
+                // supported commands above; SQL-capable inputs fall back.
+            }
+            ".exit" | ".quit" => {
+                let code = args
+                    .first()
+                    .and_then(|s| s.parse::<i32>().ok())
+                    .unwrap_or(0);
+                return Ok(Some(code));
+            }
+            other => {
+                return Err(format!(
+                    "Error: unsupported shell-only fast-path command: {other}"
+                ));
+            }
+        }
+    }
+
+    Ok(None)
+}
