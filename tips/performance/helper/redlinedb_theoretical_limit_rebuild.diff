+use assert_cmd::Command;
+
+#[test]
+fn shell_only_output_and_print_do_not_create_database() {
+    let tmp = tempfile::tempdir().unwrap();
+    let db = tmp.path().join("should-not-open.redline");
+    let out = tmp.path().join("out.txt");
+    let input = format!(".output {}\n.print ok", out.display());
+
+    Command::cargo_bin("redlinedb")
+        .unwrap()
+        .arg(&db)
+        .arg(input)
+        .assert()
+        .success();
+
+    assert_eq!(std::fs::read_to_string(&out).unwrap(), "ok\n");
+    assert!(!db.exists(), "shell-only dot commands must not open/create a DB");
+}
+
+#[test]
+fn shell_only_read_uses_fast_path_when_script_has_no_sql() {
+    let tmp = tempfile::tempdir().unwrap();
+    let db = tmp.path().join("should-not-open-read.redline");
+    let script = tmp.path().join("script.sql");
+    let out = tmp.path().join("read-out.txt");
+    std::fs::write(
+        &script,
+        format!(".output {}\n.print read-ok\n", out.display()),
+    )
+    .unwrap();
+
+    Command::cargo_bin("redlinedb")
+        .unwrap()
+        .arg(&db)
+        .arg(format!(".read {}", script.display()))
+        .assert()
+        .success();
+
+    assert_eq!(std::fs::read_to_string(&out).unwrap(), "read-ok\n");
+    assert!(!db.exists(), "shell-only .read must not open/create a DB");
+}
+
+#[test]
+fn shell_only_read_falls_back_when_script_contains_sql() {
+    let tmp = tempfile::tempdir().unwrap();
+    let db = tmp.path().join("normal-path.redline");
+    let script = tmp.path().join("script.sql");
+    std::fs::write(&script, "CREATE TABLE t(x);\n").unwrap();
+
+    Command::cargo_bin("redlinedb")
+        .unwrap()
+        .arg(&db)
+        .arg(format!(".read {}", script.display()))
+        .assert()
+        .success();
+}
