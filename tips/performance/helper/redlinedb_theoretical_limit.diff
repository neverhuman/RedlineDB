+fn partition_total_aggregate_window(
+    func_name: &str,
+    args: &[Expr],
+    rows: &[SqlRow],
+    layouts: &[CachedWindowPartition],
+    frame: &ResolvedFrame,
+    bindings: &[Option<SqlValue>],
+    results: &mut [SqlValue],
