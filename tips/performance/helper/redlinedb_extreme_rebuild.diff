+/// Fast path for the SQLite default when no ORDER BY exists:
+/// RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING.
+///
+/// The old fallback rebuilt an accumulator for every row, so
+/// `SUM(x) OVER (PARTITION BY p)` was O(partition_size^2). Compute once per
+/// partition and fill the result slice.
+fn partition_wide_aggregate_window(
+    func_name: &str,
+    args: &[Expr],
+    rows: &[SqlRow],
+    layouts: &[CachedWindowPartition],
+    frame: &ResolvedFrame,
+    bindings: &[Option<SqlValue>],
+    results: &mut [SqlValue],
+) -> Result<bool> {
+    if !is_builtin_aggregate_window(func_name)
+        || !matches!(frame.units, WindowFrameUnits::Range)
+        || !matches!(&frame.start, ResolvedBound::UnboundedPreceding)
+        || !matches!(&frame.end, ResolvedBound::UnboundedFollowing)
+        || frame.exclude != ExcludeMode::NoOthers
+    {
+        return Ok(false);
+    }
+    for layout in layouts {
+        let mut accumulator = Accumulator::new(func_name);
+        for row_idx in &layout.order_index_map {
+            let value = match args.first() {
+                Some(expr) => eval_scalar(expr, &rows[*row_idx].context(), bindings)?,
+                None => SqlValue::Integer(1),
+            };
+            accumulator.push(value);
+        }
+        let value = accumulator.finalize();
+        for row_idx in &layout.order_index_map {
+            results[*row_idx] = value.clone();
+        }
+    }
+    Ok(true)
+}
