+fn write_hex_upper<W: Write>(out: &mut W, bytes: &[u8]) -> Result<(), String> {
+    const HEX: &[u8; 16] = b"0123456789ABCDEF";
+    const CHUNK: usize = 16 * 1024;
+    let mut encoded = [0u8; CHUNK * 2];
+    for input in bytes.chunks(CHUNK) {
+        for (i, &b) in input.iter().enumerate() {
+            encoded[i * 2] = HEX[(b >> 4) as usize];
+            encoded[i * 2 + 1] = HEX[(b & 0x0f) as usize];
+        }
+        out.write_all(&encoded[..input.len() * 2])
+            .map_err(|err| err.to_string())?;
+    }
+    Ok(())
+}
