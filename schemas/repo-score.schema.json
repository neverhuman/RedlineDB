{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/redline-testing/schemas/repo-score.schema.json",
  "title": "redline-testing Jankurai repository score attestation",
  "type": "object",
  "required": ["score", "raw_score", "decision", "caps_applied", "findings"],
  "properties": {
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "raw_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "decision": {
      "oneOf": [
        { "type": "string" },
        { "type": "object" }
      ]
    },
    "caps_applied": {
      "type": "array",
      "items": { "type": "string" }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity"],
        "properties": {
          "rule_id": { "type": "string" },
          "severity": { "type": "string" },
          "path": { "type": "string" },
          "rerun_command": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
