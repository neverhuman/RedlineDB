{
  "title": "Jain program design-input custody receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "release", "source_root", "inputs", "protected_baselines"],
  "properties": {
    "format": { "const": "jain.program-design-input-custody" },
    "release": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_root": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "copy", "sha256", "bytes"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "copy": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "protected_baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "release", "path", "sha256", "entries"],
        "properties": {
          "kind": { "enum": ["file", "tree_inventory"] },
          "release": { "type": "string", "minLength": 1, "maxLength": 128 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "entries": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
