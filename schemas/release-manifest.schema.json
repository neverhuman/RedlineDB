{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/redline-testing/schemas/release-manifest.schema.json",
  "title": "redline-testing release manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "target",
    "release_commit",
    "release_tree",
    "release_tag",
    "release_tag_state",
    "tag_revision",
    "source_archive_sha256",
    "binary",
    "binary_sha256",
    "tarball_sha256_source",
    "artifact_hashes",
    "generated_by"
  ],
  "properties": {
    "name": { "const": "redline-testing" },
    "version": { "type": "string" },
    "target": { "type": "string" },
    "release_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_tag": {
      "type": "string",
      "pattern": "^redline-testing-v1\\.0\\.1-jain\\.[1-9][0-9]*$"
    },
    "release_tag_state": { "enum": ["planned", "live"] },
    "tag_revision": { "type": "integer", "minimum": 1 },
    "source_archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binary": { "const": "bin/redline-testing" },
    "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tarball_sha256_source": { "const": ".sha256 sidecar" },
    "artifact_hashes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\t]+$"
      },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "generated_by": { "const": "scripts/release-package.sh" }
  },
  "additionalProperties": false
}
