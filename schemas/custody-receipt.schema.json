{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redline.custody-receipt/v1",
  "title": "Redline offline custody receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "artifact_path",
    "artifact_sha256",
    "cargo_lock_sha256",
    "cargo_home",
    "dependency_count",
    "dependency_closure_sha256",
    "dependencies",
    "rustc",
    "cargo",
    "oracles",
    "build_command",
    "network_policy"
  ],
  "properties": {
    "schema_version": { "const": "redline.custody-receipt/v1" },
    "status": { "const": "pass" },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cargo_lock_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cargo_home": { "type": "string", "minLength": 1 },
    "dependency_count": { "type": "integer", "minimum": 1 },
    "dependency_closure_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dependencies": { "type": "array", "minItems": 1 },
    "rustc": { "type": "object" },
    "cargo": { "type": "object" },
    "oracles": {
      "type": "object",
      "required": ["sqlite", "postgres_client", "postgres_server"]
    },
    "build_command": { "const": "cargo build --workspace --locked --offline" },
    "network_policy": { "type": "string", "minLength": 1 }
  }
}
