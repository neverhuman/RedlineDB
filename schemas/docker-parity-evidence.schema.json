{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redline.docker-parity-evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "mode",
    "provenance_source",
    "core",
    "testing",
    "images",
    "docker_engine",
    "docker_inputs",
    "cargo_custody",
    "custody_receipt",
    "container",
    "sqlite",
    "postgres_oracle",
    "postgres_target",
    "postgres_exclusions",
    "per_contract_evidence_sha256",
    "output_sha256",
    "release_failures",
    "command"
  ],
  "properties": {
    "schema_version": { "const": "redline.docker-parity-evidence/v1" },
    "status": { "enum": ["candidate", "pass", "failed", "diagnostic-pass", "diagnostic-fail"] },
    "mode": { "enum": ["release", "diagnostic"] },
    "provenance_source": { "const": "local-jeryu" },
    "core": { "type": "object" },
    "testing": { "type": "object" },
    "images": { "type": "object" },
    "docker_engine": { "type": "object" },
    "docker_inputs": { "type": "object" },
    "cargo_custody": { "type": "object" },
    "custody_receipt": { "type": "object" },
    "container": { "type": "object" },
    "sqlite": { "type": "object" },
    "postgres_oracle": { "type": "object" },
    "postgres_target": { "type": "object" },
    "postgres_exclusions": { "type": "array", "maxItems": 114 },
    "per_contract_evidence_sha256": { "type": "object" },
    "output_sha256": { "type": "object" },
    "release_failures": { "type": "array", "items": { "type": "string" } },
    "command": { "type": "object" },
    "cleanup": { "type": "object" }
  }
}
