#!/usr/bin/env bash
set -euo pipefail

ops_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="${REDLINE_SPLIT_ROOT:-$(cd "$ops_root/.." && pwd)}"
manifest="${REDLINE_SPLIT_MANIFEST:-$ops_root/repos.manifest.toml}"
lockfile="${REDLINE_SPLIT_LOCK:-$ops_root/redline.lock.toml}"

die() {
  printf 'redlinectl: %s\n' "$*" >&2
  exit 1
}

[[ -r "$manifest" ]] || die "manifest is not readable: $manifest"

manifest_rows() {
  python3 - "$manifest" <<'PY'
import sys
import tomllib
from pathlib import Path

path = Path(sys.argv[1])
data = tomllib.loads(path.read_text())
for repo in data.get("repo", []):
    print("\t".join([
        repo["name"], repo["path"], repo["github_slug"],
        repo.get("default_branch", "main"), repo.get("required_check", ""),
    ]))
PY
}

repo_path() {
  local relative="$1"
  python3 - "$manifest" "$relative" <<'PY'
import sys
from pathlib import Path
print((Path(sys.argv[1]).parent / sys.argv[2]).resolve())
PY
}

with_lock() {
  exec 9>"$workspace_root/.redline-family.lock"
  flock -x 9
  "$@"
}

verify_lock() {
  [[ -r "$lockfile" ]] || die "lock file is not readable: $lockfile"
  python3 - "$manifest" "$lockfile" <<'PY'
import subprocess
import sys
import tomllib
import re
from pathlib import Path

manifest_path, lock_path = map(Path, sys.argv[1:])
manifest = tomllib.loads(manifest_path.read_text())
lock = tomllib.loads(lock_path.read_text())
mirror_path = lock_path.parent.parent / "redline-split" / "redline.lock.toml"
if mirror_path.exists():
    mirror = tomllib.loads(mirror_path.read_text())
    for field in ("schema_version", "family", "engine_tag", "engine_commit", "proof_lock_id", "consumers"):
        if mirror.get(field) != lock.get(field):
            raise SystemExit(f"control-plane lock mirror drift in {field}")
    if mirror.get("proof", {}).get("parity_status") != lock.get("proof", {}).get("parity_status"):
        raise SystemExit("control-plane lock mirror drift in proof.parity_status")
locked = {entry["name"]: entry for entry in lock.get("repo", [])}
errors = []
if lock.get("family") != "redline-split":
    errors.append("lock family must be redline-split")
if lock.get("parent_family") != "independent":
    errors.append("redline lock must remain an independent family")
if sorted(lock.get("consumers", [])) != ["jain-split", "jeryu-split"]:
    errors.append("lock consumers must be exactly jain-split and jeryu-split")
engine_entry = next((entry for entry in lock.get("repo", []) if entry.get("name") == "redline-core"), None)
if not engine_entry or lock.get("engine_commit") != engine_entry.get("commit"):
    errors.append("engine_commit must match redline-core lock commit")
if not re.fullmatch(r"[0-9a-f]{40}", str(lock.get("engine_commit", ""))):
    errors.append("engine_commit must be a 40-character commit")
for repo in manifest.get("repo", []):
    name = repo["name"]
    entry = locked.get(name)
    if entry is None:
        errors.append(f"{name}: missing lock entry")
        continue
    root = (manifest_path.parent / repo["path"]).resolve()
    if not (root / ".git").exists():
        errors.append(f"{name}: checkout missing at {root}")
        continue
    head = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True, check=False).stdout.strip()
    if head != entry["commit"]:
        errors.append(f"{name}: HEAD {head} != lock {entry['commit']}")
    if not re.fullmatch(r"[0-9a-f]{40}", str(entry.get("commit", ""))):
        errors.append(f"{name}: lock commit is not immutable")
    tag = subprocess.run(["git", "-C", str(root), "rev-parse", "--verify", f"{entry['tag']}^{{commit}}"], capture_output=True, text=True, check=False).stdout.strip()
    if tag != entry["commit"]:
        errors.append(f"{name}: tag {entry['tag']} does not resolve to lock commit")
if errors:
    raise SystemExit("\n".join(errors))
print(f"redline lock ok: {len(locked)} repositories")
PY
}

validate() {
  python3 - "$manifest" <<'PY'
import sys
import tomllib
from pathlib import Path

path = Path(sys.argv[1])
data = tomllib.loads(path.read_text())
if data.get("family") != "redline-split":
    raise SystemExit("manifest family must be redline-split")
if data.get("parent_family") != "independent":
    raise SystemExit("manifest parent_family must be independent")
if sorted(data.get("consumers", [])) != ["jain-split", "jeryu-split"]:
    raise SystemExit("manifest consumers must be exactly jain-split and jeryu-split")
seen = set()
for repo in data.get("repo", []):
    name = repo["name"]
    if name in seen:
        raise SystemExit(f"duplicate repository: {name}")
    seen.add(name)
    raw = repo["path"]
    if Path(raw).is_absolute() or "/home/ubuntu" in raw:
        raise SystemExit(f"{name}: manifest path must be relative: {raw}")
    checkout = (path.parent / raw).resolve()
    if not (checkout / ".git").exists():
        raise SystemExit(f"{name}: missing independent git checkout: {checkout}")
    if checkout == path.parent or checkout == path.parent.parent:
        raise SystemExit(f"{name}: child path escapes the family boundary")
if len(seen) != 4:
    raise SystemExit(f"expected four Redline child repositories, found {len(seen)}")
if (path.parent / "Cargo.toml").exists():
    raise SystemExit("redline-split must not become an umbrella Cargo workspace")
print(f"redline manifest ok: {', '.join(sorted(seen))}")
PY
  bash "$(repo_path ../redline-split/redline)/scripts/guard-no-duplicate-engine.sh"
  verify_lock
}

clone_family() {
  local dry_run=0
  if [[ "${1:-}" == "--dry-run" ]]; then dry_run=1; shift; fi
  while IFS=$'\t' read -r name relative github branch _required commit tag; do
    local checkout
    checkout="$(repo_path "$relative")"
    if [[ "$dry_run" == 1 ]]; then
      printf 'would clone/update %s -> %s\n' "https://github.com/$github.git" "$checkout"
      continue
    fi
    if [[ -d "$checkout/.git" ]]; then
      git -C "$checkout" fetch --prune origin "$commit" "$tag"
    elif [[ -e "$checkout" ]]; then
      die "$name checkout path exists but is not a Git repository: $checkout"
    else
      mkdir -p "$(dirname "$checkout")"
      git clone "https://github.com/$github.git" "$checkout"
    fi
    git -C "$checkout" fetch --prune origin "$commit" "$tag"
    git -C "$checkout" checkout --detach "$commit"
    [[ "$(git -C "$checkout" rev-parse HEAD)" == "$commit" ]] || die "$name did not checkout locked commit"
    [[ "$(git -C "$checkout" rev-parse --verify "$tag^{commit}")" == "$commit" ]] || die "$name tag $tag does not resolve to locked commit"
  done < <(python3 - "$manifest" "$lockfile" <<'PY'
import sys
import tomllib
from pathlib import Path
manifest = tomllib.loads(Path(sys.argv[1]).read_text())
lock = {item["name"]: item for item in tomllib.loads(Path(sys.argv[2]).read_text())["repo"]}
for repo in manifest.get("repo", []):
    item = lock[repo["name"]]
    print("\t".join([repo["name"], repo["path"], repo["github_slug"], repo.get("default_branch", "main"), repo.get("required_check", ""), item["commit"], item["tag"]]))
PY
  )
}

family_ci() {
  local name relative _github _branch required checkout
  while IFS=$'\t' read -r name relative _github _branch required; do
    checkout="$(repo_path "$relative")"
    printf 'redline family CI: %s (%s)\n' "$name" "$required"
    if [[ "$name" == "redline" ]]; then
      (cd "$checkout" && bash scripts/guard-no-duplicate-engine.sh)
    elif [[ -x "$checkout/ops/ci/pr-ci.sh" ]]; then
      (cd "$checkout" && bash ops/ci/pr-ci.sh)
    elif [[ -x "$checkout/scripts/ci-local.sh" ]]; then
      (cd "$checkout" && bash scripts/ci-local.sh pr-ci)
    else
      die "$name has no independent CI entrypoint"
    fi
  done < <(manifest_rows)
}

doctor() {
  command -v git >/dev/null || die "git is required"
  command -v python3 >/dev/null || die "python3 is required for TOML validation"
  command -v flock >/dev/null || die "flock is required for family locking"
  validate
  printf 'redline doctor: ok (%s)\n' "$workspace_root"
}

cutover_verify() {
  python3 - "$lockfile" <<'PY'
import sys
import tomllib
from pathlib import Path
lock = tomllib.loads(Path(sys.argv[1]).read_text())
proof = lock.get("proof", {})
if proof.get("parity_status") != "accepted":
    raise SystemExit("cutover blocked: Redline parity evidence is not current")
if proof.get("cutover_eligible") is not True:
    raise SystemExit("cutover blocked: Redline proof lock is not eligible")
required = set(proof.get("required_consumer_evidence", []))
present = set(proof.get("accepted_consumer_evidence", []))
missing = sorted(required - present)
if missing:
    raise SystemExit("cutover blocked: missing consumer evidence: " + ", ".join(missing))
print("redline cutover proof accepted")
PY
}

consumer_verify() {
  local consumer_lock="${1:-}"
  [[ -r "$consumer_lock" ]] || die "consumer lock is not readable: $consumer_lock"
  python3 - "$consumer_lock" <<'PY'
import sys
import tomllib
from pathlib import Path

data = tomllib.loads(Path(sys.argv[1]).read_text())
consumer = data.get("nested", {}).get("redline", data)
if "redline_engine_commit" in consumer:
    consumer = {
        **consumer,
        "engine_commit": consumer.get("redline_engine_commit"),
        "engine_tag": consumer.get("redline_engine_tag"),
        "proof_lock_id": consumer.get("redline_proof_lock_id"),
    }
expected_commit = "9c72c26fac280ebf861eef43aa406c04ecbcf024"
expected_tag = "redline-core-v4.1.0-jain.1"
expected_proof = "redline-proof/v2/4.1.0/9c72c26fac280ebf861eef43aa406c04ecbcf024"
checks = {
    "engine_commit": expected_commit,
    "engine_tag": expected_tag,
    "proof_lock_id": expected_proof,
}

for field, expected in checks.items():
    if consumer.get(field) != expected:
        raise SystemExit(f"consumer lock drift in {field}: expected {expected}")
print(f"consumer lock ok: {consumer.get('consumer', data.get('family', 'unknown'))}")
PY
}

remote_verify() {
  python3 - "$lockfile" <<'PY'
import subprocess
import sys
import tomllib
from pathlib import Path

lock = tomllib.loads(Path(sys.argv[1]).read_text())
for row in lock.get("repo", []):
    for label, remote in (("github", row.get("github")), ("jeryu", row.get("jeryu"))):
        if not remote:
            raise SystemExit(f"{row['name']}: missing {label} remote")
        result = subprocess.run(
            ["git", "ls-remote", remote, f"refs/tags/{row['tag']}", f"refs/tags/{row['tag']}^{{}}"],
            capture_output=True,
            text=True,
            check=False,
        )
        commits = {line.split()[0] for line in result.stdout.splitlines() if line.split()}
        if row["commit"] not in commits:
            raise SystemExit(f"{row['name']}: {label} does not expose locked tag commit")
print("Redline remote tags verified on Jeryu and GitHub")
PY
}

case "${1:-doctor}" in
  clone) shift; with_lock clone_family "$@" ;;
  update) with_lock clone_family ;;
  validate) validate ;;
  lock-verify) verify_lock ;;
  cutover-verify) cutover_verify ;;
  consumer-verify) shift; consumer_verify "$@" ;;
  remote-verify) remote_verify ;;
  family-ci|ci) with_lock family_ci ;;
  doctor) doctor ;;
  *) die "usage: $0 {clone [--dry-run]|update|validate|lock-verify|consumer-verify|remote-verify|cutover-verify|family-ci|doctor}" ;;
esac
