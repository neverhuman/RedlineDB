#!/usr/bin/env bash
# JANKURAI MANAGED HOOK: pre-commit (staged-files save-gate)
#
# Requires the current branch to already contain the latest `origin/main`
# before the commit proceeds, then runs `jankurai audit-file` against each
# staged file's *staged* content (not on-disk content) in save-gate mode.
# Aborts the commit on any new hard finding. Designed to complete in <2s for
# a typical 5-file commit.
#
# Bypass: JANKURAI_SKIP_HOOKS=1 git commit ...
# Chain:  set JANKURAI_PRE_COMMIT_CHAIN to a prior hook executable
set -euo pipefail

if [ "${JANKURAI_SKIP_HOOKS:-}" = "1" ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
git_dir="$(git rev-parse --git-dir 2>/dev/null || printf '%s/.git' "$repo_root")"
case "$git_dir" in
  /*) ;;
  *) git_dir="$repo_root/$git_dir" ;;
esac
jankurai_dir="$git_dir/jankurai"
mkdir -p "$jankurai_dir"

env_file="$jankurai_dir/env"
if [ -f "$env_file" ]; then
  # shellcheck disable=SC1090
  . "$env_file"
fi

main_branch="${JANKURAI_MAIN_BRANCH:-main}"
remote="${JANKURAI_MAIN_REMOTE:-origin}"

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -n "$current_branch" ] && [ "$current_branch" != "$main_branch" ]; then
  echo "Checking whether '$current_branch' is up to date with $remote/$main_branch..." >&2
  if ! git fetch "$remote" "$main_branch" --quiet; then
    echo "Unable to fetch $remote/$main_branch; commit blocked." >&2
    exit 1
  fi
  main_ref="$remote/$main_branch"

  if ! git merge-base --is-ancestor "$main_ref" HEAD; then
    cat >&2 <<EOF

❌ Commit blocked.
Your branch does not contain the latest $main_ref.

Run:
  git fetch $remote
  git rebase $main_ref

Then try committing again.
EOF
    exit 1
  fi
fi

if [ -n "${JANKURAI_PRE_COMMIT_CHAIN:-}" ] && [ -x "$JANKURAI_PRE_COMMIT_CHAIN" ] && [ -z "${JANKURAI_CHAINED_HOOK:-}" ]; then
  JANKURAI_CHAINED_HOOK=1 "$JANKURAI_PRE_COMMIT_CHAIN" "$@"
fi

if [ -n "${JANKURAI_BIN:-}" ] && [ -x "$JANKURAI_BIN" ]; then
  jankurai_cmd="$JANKURAI_BIN"
else
  jankurai_cmd="${JANKURAI_FALLBACK_BIN:-jankurai}"
fi

cd "$repo_root"

report_dir="${JANKURAI_HOOK_REPORT_DIR:-target/jankurai/hooks}"
mkdir -p "$report_dir"
agg_report="$report_dir/pre-commit-staged.json"
agg_log="$report_dir/pre-commit-staged.log"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/jankurai-precommit.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT

# Portable NUL-delimited read (macOS bash 3.2 lacks `mapfile -d`).
staged=()
while IFS= read -r -d '' entry; do
  staged+=("$entry")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#staged[@]}" -eq 0 ]; then
  : > "$agg_log"
  cat > "$agg_report" <<EOF
{"schema":"redlinedb-precommit/1","verdict":"pass","files_scanned":0,"summary":"no staged files"}
EOF
  exit 0
fi

failed=0
blocked_files=()
declare -a per_file_lines
files_scanned=0
start_epoch="$(date +%s)"

> "$agg_log"

for path in "${staged[@]}"; do
  [ -z "$path" ] && continue
  files_scanned=$((files_scanned + 1))

  # Skip vendored/generated trees up front. audit-file would skip-and-pass
  # them itself, but this saves the subprocess.
  case "$path" in
    target/*|node_modules/*|*.lock) continue ;;
  esac

  # Determine op + baseline.
  # - If file exists in HEAD: op=modify, baseline=HEAD content (so save-gate
  #   diffs the staged content against the previously-committed content).
  # - Otherwise: op=create, baseline=empty file (forces every finding to count
  #   as `new`; without an explicit baseline, save-gate treats findings in a
  #   freshly-created file as `preexisting` and lets them through).
  unset baseline_arg
  baseline_arg=()
  baseline_file="$tmp_dir/baseline-$files_scanned"
  op="modify"
  if git cat-file -e "HEAD:$path" 2>/dev/null && git show "HEAD:$path" > "$baseline_file" 2>/dev/null; then
    baseline_arg=(--baseline "$baseline_file")
  else
    op="create"
    : > "$baseline_file"
    baseline_arg=(--baseline "$baseline_file")
  fi

  json_out="$tmp_dir/result-$files_scanned.json"

  # `${baseline_arg[@]+...}` keeps `set -u` happy when the array is empty.
  set +e
  git show ":$path" 2>/dev/null \
    | "$jankurai_cmd" audit-file \
        --path "$path" \
        --candidate - \
        --op "$op" \
        --mode save-gate \
        --format json \
        --json-out "$json_out" \
        ${baseline_arg[@]+"${baseline_arg[@]}"} \
        > "$tmp_dir/stdout-$files_scanned" 2> "$tmp_dir/stderr-$files_scanned"
  rc=$?
  set -e

  echo "==== $path (rc=$rc) ====" >> "$agg_log"
  cat "$tmp_dir/stderr-$files_scanned" >> "$agg_log" 2>/dev/null || true

  if [ "$rc" -ne 0 ]; then
    failed=1
    blocked_files+=("$path")
    summary=""
    if [ -s "$json_out" ]; then
      summary="$(sed -n 's/^[[:space:]]*"summary":[[:space:]]*"\(.*\)",*$/\1/p' "$json_out" | head -n 1)"
    fi
    if [ -z "$summary" ]; then
      summary="audit-file exited $rc"
    fi
    per_file_lines+=("  $path — $summary")
  fi
done

end_epoch="$(date +%s)"
elapsed=$((end_epoch - start_epoch))

if [ "$failed" -ne 0 ]; then
  printf 'jankurai pre-commit: blocked %d file(s) in %ds\n' "${#blocked_files[@]}" "$elapsed" >&2
  for line in "${per_file_lines[@]}"; do
    printf '%s\n' "$line" >&2
  done
  printf 'See %s for details. Bypass: JANKURAI_SKIP_HOOKS=1 git commit ...\n' "$agg_log" >&2

  printf '{"schema":"redlinedb-precommit/1","verdict":"block","files_scanned":%d,"blocked":%d,"elapsed_seconds":%d}\n' \
    "$files_scanned" "${#blocked_files[@]}" "$elapsed" > "$agg_report"
  exit 1
fi

printf '{"schema":"redlinedb-precommit/1","verdict":"pass","files_scanned":%d,"blocked":0,"elapsed_seconds":%d}\n' \
  "$files_scanned" "$elapsed" > "$agg_report"
exit 0
