#!/usr/bin/env bash
# Optional score ratchet: run the canonical clean-head score lane and reject
# pushes unless the governed proof receipt is produced.
#
# Install manually as `.git/hooks/pre-push` when you want the full-score
# ratchet locally. The default pre-commit hook stays on staged-file audit-file
# save-gates so normal commits do not pay for a repository-wide score run.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "Running score ratchet: rtk just score"
rtk just score
test -s target/jankurai/governed-evidence.json
