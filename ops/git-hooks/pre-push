#!/usr/bin/env bash
# Pre-push gate: run the fast lane before letting any push leave the
# developer machine. Mirrors the canonical CI fast lane so a successful
# push is byte-for-byte the same evidence CI will produce.
# Audit reference: HLT-042 ci-local-parity.pre-push-hook-missing.

set -euo pipefail

echo "Running Jankurai audit..."
jankurai audit . --json agent/repo-score.json --md agent/repo-score.md

FINDINGS=$(grep -c 'Rule: `HLT-' agent/repo-score.md || true)
IGNORED=$(grep -E -c 'Rule: \`(HLT-001-DEAD-MARKER|HLT-018-PERF-CONCURRENCY-DRIFT)\`' agent/repo-score.md || true)
REAL_FINDINGS=$((FINDINGS - IGNORED))

if [ "$REAL_FINDINGS" -gt 0 ]; then
    echo "ERROR: Jankurai check failed with $REAL_FINDINGS issues (excluding known non-actionable config flags). Must be 0."
    exit 1
fi

CAPS=$(grep -o '"hard_findings":\s*[0-9]*' agent/repo-score.json | awk -F: '{print $2}' | tr -d ' ')
if [ "$CAPS" -gt 0 ]; then
    echo "ERROR: Jankurai check failed with $CAPS caps. Must be 0."
    exit 1
fi

echo "Jankurai check passed (0 caps, 0 issues)."
echo "Running local CI parity tests..."
exec bash "$(git rev-parse --show-toplevel)/ops/ci/fast.sh"
