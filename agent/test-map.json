    "AGENTS.md": {"command": "just check", "lane": "check", "purpose": "verify routed control-plane guidance"},
    "Cargo.lock": {"command": "just required && just security", "lane": "required", "purpose": "verify locked dependencies and advisories"},
    "Cargo.toml": {"command": "just required", "lane": "required", "purpose": "verify the standalone Rust tool package"},
    "CHANGELOG.md": {"command": "just release-readiness", "lane": "release", "purpose": "verify release history is present"},
    "Justfile": {"command": "just check", "lane": "check", "purpose": "verify canonical local commands"},
    "README.md": {"command": "just check", "lane": "check", "purpose": "verify root documentation and commands"},
