{
  "workspace": "redline-hub",
  "tests": {
    ".agents/": {
      "command": "just score",
      "purpose": "validate legacy agent guidance against the governed repository controls"
    },
    ".bundles/": {
      "command": "just check",
      "purpose": "validate retained custody evidence without executing archived content"
    },
    ".github/": {
      "command": "actionlint .github/workflows/*.yml",
      "purpose": "validate workflow syntax and pinned action structure"
    },
    ".gitignore": {
      "command": "just check",
      "purpose": "validate source and generated-evidence boundaries"
    },
    ".jankurai/": {
      "command": "just score",
      "purpose": "validate Jankurai control metadata and score policy"
    },
    "AGENTS.md": {
      "command": "just check",
      "purpose": "validate hub ownership and proof routing"
    },
    "CHANGELOG.md": {
      "command": "just score",
      "purpose": "keep release changes visible to the governed audit"
    },
    "README.md": {
      "command": "just check",
      "purpose": "validate the public hub entrypoint"
    },
    "VERSION": {
      "command": "just check",
      "purpose": "validate the hub compatibility-track source"
    },
    "agent/": {
      "command": "just score",
      "purpose": "validate agent control manifests"
    },
    "assets/": {
      "command": "just score",
      "purpose": "audit committed hub evidence assets"
    },
    "db/": {
      "command": "just check",
      "purpose": "enforce the hub no-database-truth boundary"
    },
    "docs/": {
      "command": "just score",
      "purpose": "validate release and audit guidance"
    },
    "justfile": {
      "command": "just test",
      "purpose": "run the canonical hub test lane"
    },
    "ops/": {
      "command": "just check",
      "purpose": "run required CI control-plane proof"
    },
    "schemas/": {
      "command": "just score",
      "purpose": "validate governed evidence schemas"
    },
    "scripts/": {
      "command": "just check",
      "purpose": "validate hub guard and audit dispatch scripts"
    },
    "tools/": {
      "command": "just security",
      "purpose": "validate security wrappers and the Rust evidence processor"
    }
  }
}
