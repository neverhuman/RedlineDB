{
  "tests": {
    ".github/": {"command": "just security", "lane": "security", "purpose": "lint pinned read-only workflows"},
    ".github/**": {"command": "just security", "lane": "security", "purpose": "lint pinned read-only workflows"},
    ".gitignore": {"command": "just check", "lane": "check", "purpose": "verify generated-output boundaries"},
    ".gitleaks.toml": {"command": "just security", "lane": "security", "purpose": "verify secret scan policy"},
    "AGENTS.md": {"command": "just check", "lane": "check", "purpose": "verify routed control-plane guidance"},
    "Cargo.lock": {"command": "just required && just security", "lane": "required", "purpose": "verify locked dependencies and advisories"},
    "Cargo.toml": {"command": "just required", "lane": "required", "purpose": "verify the standalone Rust tool package"},
    "CHANGELOG.md": {"command": "just release-readiness", "lane": "release", "purpose": "verify release history is present"},
    "Justfile": {"command": "just check", "lane": "check", "purpose": "verify canonical local commands"},
    "README.md": {"command": "just check", "lane": "check", "purpose": "verify root documentation and commands"},
    "RELEASE_PROCESS.md": {"command": "just release-readiness", "lane": "release", "purpose": "verify release command policy"},
    "ROLLBACK.md": {"command": "just release-readiness", "lane": "release", "purpose": "verify rollback policy"},
    "agent/": {"command": "just score", "lane": "score", "purpose": "verify audit routing metadata"},
    "agent/**": {"command": "just score", "lane": "score", "purpose": "verify audit routing metadata"},
    "docs/": {"command": "just check && just score", "lane": "docs", "purpose": "verify release and repair guidance"},
    "docs/**": {"command": "just check && just score", "lane": "docs", "purpose": "verify release and repair guidance"},
    "deny.toml": {"command": "just security", "lane": "security", "purpose": "verify dependency policy"},
    "redline.lock.toml": {"command": "./redlinectl review-lock-verify", "lane": "lock-review", "purpose": "verify a synchronized lock or the exact bound successor review state"},
    "redline.lock.toml.sha256": {"command": "sha256sum -c redline.lock.toml.sha256", "lane": "lock", "purpose": "verify the authoritative proof-lock digest"},
    "redlinectl": {"command": "just required", "lane": "required", "purpose": "verify the Rust launcher and lock discipline"},
    "release-evidence/": {"command": "just required && just security", "lane": "release-review", "purpose": "verify checksummed candidate evidence without claiming cutover eligibility"},
    "release-evidence/**": {"command": "just required && just security", "lane": "release-review", "purpose": "verify checksummed candidate evidence without claiming cutover eligibility"},
    "release-evidence/**/redline-proof-refresh*.json": {"command": "./redlinectl cutover-verify && just security", "lane": "cutover", "purpose": "reconstruct final eligibility from the normal two-consumer proof refresh"},
    "release-evidence/8.0.0/redline-proof-successor-jain4-prepared.json": {"command": "./redlinectl successor-receipt-verify release-evidence/8.0.0/redline-proof-successor-jain4-prepared.json && ./redlinectl review-lock-verify", "lane": "successor-prepare", "purpose": "verify the closed preparation receipt and exact split review state without claiming cutover"},
    "release-evidence/8.0.0/redline-proof-successor-jain4-reconciled.json": {"command": "./redlinectl successor-receipt-verify release-evidence/8.0.0/redline-proof-successor-jain4-reconciled.json && ./redlinectl lock-verify", "lane": "successor-reconcile", "purpose": "verify the changed reconciled receipt and synchronized historical lock without claiming cutover"},
    "release-evidence/**/jain-consumer.json": {"command": "./redlinectl cutover-verify && just security", "lane": "cutover", "purpose": "bind final cutover to governed Jain consumer evidence"},
    "release-evidence/**/jeryu-consumer.json": {"command": "./redlinectl cutover-verify && just security", "lane": "cutover", "purpose": "bind final cutover to governed Jeryu consumer evidence"},
    "repos.manifest.toml": {"command": "./redlinectl authority-validate && cargo test --locked", "lane": "authority-source", "purpose": "verify exact six-repository veox authority while preserving pre-refresh lock failures"},
    "rust-toolchain.toml": {"command": "just check", "lane": "check", "purpose": "verify the pinned Rust toolchain"},
    "scripts/": {"command": "just check", "lane": "check", "purpose": "verify local CI dispatchers"},
    "scripts/**": {"command": "just check", "lane": "check", "purpose": "verify local CI dispatchers"},
    "schemas/": {"command": "just required", "lane": "contract", "purpose": "parse governed receipt schemas"},
    "schemas/**": {"command": "just required", "lane": "contract", "purpose": "parse governed receipt schemas"},
    "ops/": {"command": "bash ops/ci/quality-gates.sh", "lane": "ci", "purpose": "verify canonical CI orchestration"},
    "ops/**": {"command": "bash ops/ci/quality-gates.sh", "lane": "ci", "purpose": "verify canonical CI orchestration"},
    "tools/": {"command": "./redlinectl authority-validate && cargo test --locked && cargo clippy --locked --all-targets -- -D warnings", "lane": "authority-source", "purpose": "run Rust authority, proof, and safety tests without relabeling lock readiness"},
    "tools/**": {"command": "./redlinectl authority-validate && cargo test --locked && cargo clippy --locked --all-targets -- -D warnings", "lane": "authority-source", "purpose": "run Rust authority, proof, and safety tests without relabeling lock readiness"}
  },
  "workspace": "redline-split-ops"
}
