+fn first_frame_position(
+    frame: &ResolvedFrame,
+    bounds: (usize, usize),
+    sorted_pos: usize,
+    peer_ids: &[usize],
+    total: usize,
+) -> Option<usize> {
+    if bounds.0 > bounds.1 || total == 0 {
+        return None;
+    }
+    let end = bounds.1.min(total.saturating_sub(1));
+    for pos in bounds.0..=end {
+        if !position_excluded(frame, pos, sorted_pos, peer_ids) {
+            return Some(pos);
+        }
+    }
+    None
+}
+
+fn last_frame_position(
+    frame: &ResolvedFrame,
+    bounds: (usize, usize),
+    sorted_pos: usize,
+    peer_ids: &[usize],
+    total: usize,
+) -> Option<usize> {
+    if bounds.0 > bounds.1 || total == 0 {
+        return None;
+    }
+    let end = bounds.1.min(total.saturating_sub(1));
+    for pos in (bounds.0..=end).rev() {
+        if !position_excluded(frame, pos, sorted_pos, peer_ids) {
+            return Some(pos);
+        }
+    }
+    None
+}
+
+fn nth_frame_position(
+    frame: &ResolvedFrame,
+    bounds: (usize, usize),
+    sorted_pos: usize,
+    peer_ids: &[usize],
+    total: usize,
+    nth: usize,
+) -> Option<usize> {
+    if nth == 0 || bounds.0 > bounds.1 || total == 0 {
+        return None;
+    }
+    let end = bounds.1.min(total.saturating_sub(1));
+    let mut remaining = nth;
+    for pos in bounds.0..=end {
+        if position_excluded(frame, pos, sorted_pos, peer_ids) {
+            continue;
+        }
+        remaining -= 1;
+        if remaining == 0 {
+            return Some(pos);
+        }
+    }
+    None
+}
