+        Self {
+            work_mem_bytes: 256 * 1024,
+            max_spill_bytes: 64 * 1024 * 1024,
+            batch_rows: 128,
+        }
+    }
+
+    pub fn clamp_to_lean_ephemeral(&mut self) {
+        self.work_mem_bytes = self.work_mem_bytes.min(256 * 1024);
+        self.max_spill_bytes = self.max_spill_bytes.min(64 * 1024 * 1024);
+        self.batch_rows = self.batch_rows.clamp(16, 128);
+    }
