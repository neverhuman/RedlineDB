diff --git a/crates/kernel/src/engine/lock/policy.rs b/crates/kernel/src/engine/lock/policy.rs
new file mode 100644
index 0000000..491e8dd
--- /dev/null
+++ b/crates/kernel/src/engine/lock/policy.rs
@@ -0,0 +1,109 @@
+#![allow(dead_code)]
+
+use std::time::Duration;
+
+use crate::stage::{KernelStage, StageDomain, StageSpec};
+
+const LOCK_WAIT_INVARIANTS: &[&str] = &[
+    "wait policy must not grant lock ownership",
+    "wait policy must not reorder FIFO waiter queues",
+    "timeout must not fire before the configured busy timeout has elapsed",
+    "park durations must be finite and advisory",
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct LockWaitContext {
+    pub elapsed: Duration,
+    pub timeout: Duration,
+}
+
+pub(crate) trait LockWaitPolicy: KernelStage {
+    fn park_duration(ctx: LockWaitContext) -> Option<Duration>;
+
+    fn timed_out(ctx: LockWaitContext) -> bool {
+        ctx.elapsed >= ctx.timeout
+    }
+}
+
+pub(crate) type ActiveLockWaitPolicy = LockWaitDeadlinePolicy;
+
+pub(crate) struct LockWaitDeadlinePolicy;
+
+impl KernelStage for LockWaitDeadlinePolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "lock.wait.deadline",
+        StageDomain::Lock,
+        1,
+        "park until the configured busy-timeout deadline",
+        LOCK_WAIT_INVARIANTS,
+    );
+}
+
+impl LockWaitPolicy for LockWaitDeadlinePolicy {
+    fn park_duration(ctx: LockWaitContext) -> Option<Duration> {
+        ctx.timeout.checked_sub(ctx.elapsed)
+    }
+}
+
+pub(crate) struct LockWaitShortSlicePolicy;
+
+impl KernelStage for LockWaitShortSlicePolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "lock.wait.short_slice",
+        StageDomain::Lock,
+        1,
+        "wake periodically under contention to improve timeout responsiveness",
+        LOCK_WAIT_INVARIANTS,
+    );
+}
+
+impl LockWaitPolicy for LockWaitShortSlicePolicy {
+    fn park_duration(ctx: LockWaitContext) -> Option<Duration> {
+        let remaining = ctx.timeout.checked_sub(ctx.elapsed)?;
+        Some(remaining.min(Duration::from_micros(250)))
+    }
+}
+
+pub(crate) struct LockWaitSpinThenParkPolicy;
+
+impl KernelStage for LockWaitSpinThenParkPolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "lock.wait.spin_then_park",
+        StageDomain::Lock,
+        1,
+        "use tiny early parks, then bounded millisecond parks, before timeout",
+        LOCK_WAIT_INVARIANTS,
+    );
+}
+
+impl LockWaitPolicy for LockWaitSpinThenParkPolicy {
+    fn park_duration(ctx: LockWaitContext) -> Option<Duration> {
+        let remaining = ctx.timeout.checked_sub(ctx.elapsed)?;
+        let slice = if ctx.elapsed < Duration::from_micros(50) {
+            Duration::from_micros(10)
+        } else {
+            Duration::from_millis(1)
+        };
+        Some(remaining.min(slice))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::stage::{StageDomain, assert_stage_spec};
+
+    fn audit_policy<P: LockWaitPolicy>() {
+        assert_stage_spec(P::SPEC, StageDomain::Lock);
+        let ctx = LockWaitContext {
+            elapsed: Duration::from_millis(10),
+            timeout: Duration::from_millis(50),
+        };
+        let wait = P::park_duration(ctx).expect("not timed out");
+        assert!(wait > Duration::ZERO);
+        assert!(wait <= Duration::from_millis(40));
+        assert!(!P::timed_out(ctx));
+        assert!(P::timed_out(LockWaitContext {
+            elapsed: Duration::from_millis(50),
+            timeout: Duration::from_millis(50),
+        }));
+    }
+
+    #[test]
+    fn lock_wait_drop_ins_preserve_basic_invariants() {
+        audit_policy::<LockWaitDeadlinePolicy>();
+        audit_policy::<LockWaitShortSlicePolicy>();
+        audit_policy::<LockWaitSpinThenParkPolicy>();
+    }
+}
