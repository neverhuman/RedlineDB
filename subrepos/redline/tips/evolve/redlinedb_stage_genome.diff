new file mode 100644
index 0000000..6f7d4ac
--- /dev/null
+++ b/crates/kernel/src/stage.rs
@@ -0,0 +1,83 @@
+//! Standard metadata surface for kernel performance stages.
+//!
+//! A stage is a compile-time policy family whose implementations can be
+//! swapped by changing one `Active...Policy` alias.  The trait here is
+//! intentionally metadata-only: each hot path keeps its narrow typed trait
+//! (`WalSchedulePolicy`, `BufferPolicy`, etc.) so generated replacements
+//! cannot reach across layers or mutate state outside their contract.
+
+use crate::Result;
+
+/// Broad kernel area owned by a stage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StageDomain {
+    Wal,
+    Buffer,
+    Heap,
+    Index,
+    Lock,
+    Checkpoint,
+}
+
+/// Static identity and audit contract for one stage implementation.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageSpec {
+    pub id: &'static str,
+    pub domain: StageDomain,
+    pub version: u16,
+    pub summary: &'static str,
+    pub invariants: &'static [&'static str],
+}
+
+impl StageSpec {
+    pub const fn new(
+        id: &'static str,
+        domain: StageDomain,
+        version: u16,
+        summary: &'static str,
+        invariants: &'static [&'static str],
+    ) -> Self {
+        Self {
+            id,
+            domain,
+            version,
+            summary,
+            invariants,
+        }
+    }
+}
+
+/// Common marker for every kernel stage implementation.
+///
+/// Generated candidate stages must expose a stable [`StageSpec`] so benchmark
+/// output can name the exact genome that produced a result.
+pub trait KernelStage {
+    const SPEC: StageSpec;
+}
+
+/// Optional validation hook for stages that can audit static invariants without
+/// needing a live engine.
+pub trait StagePolicy: KernelStage {
+    fn validate_contract() -> Result<()> {
+        Ok(())
+    }
+}
+
+/// Small helper used by policy-module tests.
+#[cfg(test)]
+pub(crate) fn assert_stage_spec(spec: StageSpec, domain: StageDomain) {
+    assert!(!spec.id.is_empty(), "stage id must be stable and non-empty");
+    assert_eq!(spec.domain, domain);
+    assert!(spec.version > 0, "stage version must start at 1");
+    assert!(
+        !spec.summary.is_empty(),
+        "stage summary must describe the replacement surface"
+    );
+    assert!(
+        !spec.invariants.is_empty(),
+        "stage invariants must document the safety envelope"
+    );
+}
