index 0000000..cbfdf4d
--- /dev/null
+++ b/crates/kernel/src/engine/maintenance/policy.rs
@@ -0,0 +1,119 @@
+#![allow(dead_code)]
+
+use crate::format::Lsn;
+use crate::stage::{KernelStage, StageDomain, StageSpec};
+
+const CHECKPOINT_INVARIANTS: &[&str] = &[
+    "checkpoint policy must not reorder WAL flush, page flush, sidecar writes, or control-file publish",
+    "flush batch page count must be non-zero",
+    "WAL pruning may only be skipped after a valid control file is written",
+    "policy must not change checkpoint LSN or page count",
+];
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct CheckpointContext {
+    pub resident_heap_pages: usize,
+    pub durable_lsn: Lsn,
+    pub default_batch_pages: usize,
+}
+
+pub(crate) trait CheckpointPolicy: KernelStage {
+    fn flush_batch_pages(ctx: CheckpointContext) -> usize;
+
+    fn prune_wal_after_control(_ctx: CheckpointContext) -> bool {
+        true
+    }
+}
+
+pub(crate) type ActiveCheckpointPolicy = CheckpointBalancedPolicy;
+
+pub(crate) struct CheckpointBalancedPolicy;
+
+impl KernelStage for CheckpointBalancedPolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "checkpoint.balanced",
+        StageDomain::Checkpoint,
+        1,
+        "use the configured checkpoint dirty-page batch and prune WAL after control publish",
+        CHECKPOINT_INVARIANTS,
+    );
+}
+
+impl CheckpointPolicy for CheckpointBalancedPolicy {
+    fn flush_batch_pages(ctx: CheckpointContext) -> usize {
+        ctx.default_batch_pages.max(1)
+    }
+}
+
+pub(crate) struct CheckpointLowLatencyPolicy;
+
+impl KernelStage for CheckpointLowLatencyPolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "checkpoint.low_latency",
+        StageDomain::Checkpoint,
+        1,
+        "use smaller dirty-page batches to reduce checkpoint stall bursts",
+        CHECKPOINT_INVARIANTS,
+    );
+}
+
+impl CheckpointPolicy for CheckpointLowLatencyPolicy {
+    fn flush_batch_pages(ctx: CheckpointContext) -> usize {
+        (ctx.default_batch_pages / 4).max(1)
+    }
+}
+
+pub(crate) struct CheckpointThroughputPolicy;
+
+impl KernelStage for CheckpointThroughputPolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "checkpoint.throughput",
+        StageDomain::Checkpoint,
+        1,
+        "use larger dirty-page batches to reduce checkpoint loop overhead",
+        CHECKPOINT_INVARIANTS,
+    );
+}
+
+impl CheckpointPolicy for CheckpointThroughputPolicy {
+    fn flush_batch_pages(ctx: CheckpointContext) -> usize {
+        ctx.default_batch_pages
+            .saturating_mul(4)
+            .min(ctx.resident_heap_pages.max(1))
+            .max(1)
+    }
+}
+
+pub(crate) struct CheckpointRetainWalPolicy;
+
+impl KernelStage for CheckpointRetainWalPolicy {
+    const SPEC: StageSpec = StageSpec::new(
+        "checkpoint.retain_wal",
+        StageDomain::Checkpoint,
+        1,
+        "default dirty-page batching but skip post-checkpoint WAL pruning",
+        CHECKPOINT_INVARIANTS,
+    );
+}
+
+impl CheckpointPolicy for CheckpointRetainWalPolicy {
+    fn flush_batch_pages(ctx: CheckpointContext) -> usize {
+        CheckpointBalancedPolicy::flush_batch_pages(ctx)
+    }
+
+    fn prune_wal_after_control(_ctx: CheckpointContext) -> bool {
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::stage::{StageDomain, assert_stage_spec};
+
+    fn audit_policy<P: CheckpointPolicy>() {
+        assert_stage_spec(P::SPEC, StageDomain::Checkpoint);
+        let ctx = CheckpointContext {
+            resident_heap_pages: 1024,
+            durable_lsn: Lsn(128),
+            default_batch_pages: 64,
+        };
+        assert!(P::flush_batch_pages(ctx) > 0);
+        let _ = P::prune_wal_after_control(ctx);
+    }
+
+    #[test]
+    fn checkpoint_drop_ins_preserve_basic_invariants() {
+        audit_policy::<CheckpointBalancedPolicy>();
+        audit_policy::<CheckpointLowLatencyPolicy>();
+        audit_policy::<CheckpointThroughputPolicy>();
+        audit_policy::<CheckpointRetainWalPolicy>();
+    }
+}
