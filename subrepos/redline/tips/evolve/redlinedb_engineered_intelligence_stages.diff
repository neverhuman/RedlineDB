+/// Buffer-frame facts for residency and eviction.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferResidencyInput {
+    pub page_id: PageId,
+    pub pin_count: usize,
+    pub dirty: bool,
+    pub usage_count: u8,
+    pub page_lsn: Lsn,
+    pub durable_lsn: Lsn,
+    pub resident_pages: usize,
+    pub capacity_pages: usize,
+}
+
+/// Residency decision. Callers must still reject eviction for pinned frames and
+/// dirty frames newer than the durable LSN.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct BufferResidencyDecision {
+    pub evictable: bool,
+    pub victim_score: Option<u32>,
+    pub allow_prefetch_cold_load: bool,
+}
+
+/// CLOCK-like default residency policy.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultBufferResidencyStage;
+
+impl Stage<BufferResidencyInput, BufferResidencyDecision> for DefaultBufferResidencyStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.buffer_residency"),
+            kind: StageKind::BufferResidency,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Evicts only unpinned frames with no usage count and durable dirty state.",
+        }
+    }
+
+    fn evaluate(&self, input: BufferResidencyInput) -> Result<BufferResidencyDecision> {
+        let evictable = input.pin_count == 0
+            && input.usage_count == 0
+            && (!input.dirty || input.page_lsn <= input.durable_lsn);
+        Ok(BufferResidencyDecision {
+            evictable,
+            victim_score: evictable.then_some(if input.dirty { 10 } else { 0 }),
+            allow_prefetch_cold_load: true,
+        })
+    }
+}
+
+/// Dirty checkpoint ordering strategy.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DirtySortKey {
+    PreserveDiscovery,
+    PageId,
+    PageLsnThenPageId,
+}
+
+/// Checkpoint batch facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
