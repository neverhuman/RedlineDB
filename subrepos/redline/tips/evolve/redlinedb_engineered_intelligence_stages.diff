+    pub covering_index: bool,
+}
+
+/// Access path selected by an index stage. Executors still recheck predicates.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum IndexAccessKind {
+    TableScan,
+    PointLookup,
+    RangeScan,
+    CoveringRangeScan,
+}
+
+/// Index access decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexAccessDecision {
+    pub access: IndexAccessKind,
+}
+
+/// Conservative default access selector.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultIndexAccessStage;
+
+impl Stage<IndexAccessInput, IndexAccessDecision> for DefaultIndexAccessStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.index_access"),
+            kind: StageKind::IndexAccess,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Uses point lookup for equality predicates and range scan for range/order predicates.",
+        }
+    }
+
+    fn evaluate(&self, input: IndexAccessInput) -> Result<IndexAccessDecision> {
+        let access = if input.equality_terms > 0 && input.range_terms == 0 {
+            IndexAccessKind::PointLookup
+        } else if input.range_terms > 0 || input.required_order {
+            if input.covering_index {
+                IndexAccessKind::CoveringRangeScan
+            } else {
+                IndexAccessKind::RangeScan
+            }
+        } else {
+            IndexAccessKind::TableScan
+        };
+        Ok(IndexAccessDecision { access })
+    }
+}
