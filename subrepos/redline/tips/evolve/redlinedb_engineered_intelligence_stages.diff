+/// Prefetch hint facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PrefetchInput {
+    pub page_id: PageId,
+    pub already_resident: bool,
+    pub shard_contended: bool,
+    pub resident_pages: usize,
+    pub capacity_pages: usize,
+}
+
+/// Prefetch action.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum PrefetchAction {
+    CountHit,
+    CountMissAndDrop,
+    CountMissAndColdLoad,
+}
+
+/// Prefetch decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct PrefetchDecision {
+    pub action: PrefetchAction,
+}
+
+/// Default advisory prefetch behavior.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultPrefetchStage;
+
+impl Stage<PrefetchInput, PrefetchDecision> for DefaultPrefetchStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.prefetch"),
+            kind: StageKind::Prefetch,
+            version: 1,
+            purity: StagePurity::Advisory,
+            deterministic: true,
+            notes: "Counts resident pages as hits, drops contended hints, cold-loads other misses.",
+        }
+    }
+
+    fn evaluate(&self, input: PrefetchInput) -> Result<PrefetchDecision> {
+        let action = if input.already_resident {
+            PrefetchAction::CountHit
+        } else if input.shard_contended {
+            PrefetchAction::CountMissAndDrop
+        } else {
+            PrefetchAction::CountMissAndColdLoad
+        };
+        Ok(PrefetchDecision { action })
+    }
+}
