+    pub duplicate_found: bool,
+}
+
+/// B-tree mutation decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexMutationDecision {
+    pub split_before_insert: bool,
+    pub reject_duplicate: bool,
+}
+
+/// Default index mutation stage.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultIndexMutationStage;
+
+impl Stage<IndexMutationInput, IndexMutationDecision> for DefaultIndexMutationStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.index_mutation"),
+            kind: StageKind::IndexMutation,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Splits when the incoming cell would exceed capacity and rejects observed unique duplicates.",
+        }
+    }
+
+    fn evaluate(&self, input: IndexMutationInput) -> Result<IndexMutationDecision> {
+        Ok(IndexMutationDecision {
+            split_before_insert: input
+                .page_fill_bytes
+                .saturating_add(input.incoming_cell_bytes)
+                > input.page_capacity_bytes,
+            reject_duplicate: input.is_unique && input.duplicate_found,
+        })
+    }
+}
