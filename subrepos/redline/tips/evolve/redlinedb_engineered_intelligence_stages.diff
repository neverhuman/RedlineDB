+/// B-tree mutation facts for split and uniqueness heuristics.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexMutationInput {
+    pub page_fill_bytes: usize,
+    pub page_capacity_bytes: usize,
