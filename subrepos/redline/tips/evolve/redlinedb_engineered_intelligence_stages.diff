+/// Durability mode visible to the commit barrier stage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum DurabilityMode {
+    Strict,
+    Normal,
+    UnsafeDev,
+    Volatile,
+}
+
+/// Commit barrier facts after a commit record has been reserved.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CommitBarrierInput {
+    pub durability: DurabilityMode,
+    pub end_lsn: Lsn,
+    pub written_lsn: Lsn,
+    pub durable_lsn: Lsn,
+}
+
+/// Side effect the kernel must execute before acknowledging commit success.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CommitBarrierRequirement {
+    FlushUntil(Lsn),
+    WriteUntil(Lsn),
+    AcknowledgeVolatile,
+}
+
+/// Commit barrier stage output.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CommitBarrierDecision {
+    pub requirement: CommitBarrierRequirement,
+}
+
+/// Behavior-preserving commit barrier planner.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultCommitBarrierStage;
+
+impl Stage<CommitBarrierInput, CommitBarrierDecision> for DefaultCommitBarrierStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.commit_barrier"),
+            kind: StageKind::CommitBarrier,
+            version: 1,
+            purity: StagePurity::OrderedSideEffect,
+            deterministic: true,
+            notes: "Strict flushes, normal writes, unsafe-dev and volatile acknowledge without a barrier.",
+        }
+    }
+
+    fn evaluate(&self, input: CommitBarrierInput) -> Result<CommitBarrierDecision> {
+        let requirement = match input.durability {
+            DurabilityMode::Strict => CommitBarrierRequirement::FlushUntil(input.end_lsn),
+            DurabilityMode::Normal => CommitBarrierRequirement::WriteUntil(input.end_lsn),
+            DurabilityMode::UnsafeDev | DurabilityMode::Volatile => {
+                CommitBarrierRequirement::AcknowledgeVolatile
+            }
+        };
+        Ok(CommitBarrierDecision { requirement })
+    }
+}
