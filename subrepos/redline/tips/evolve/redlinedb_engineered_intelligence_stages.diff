+/// Planner/index-access facts that can cross the SQL/kernel boundary without
+/// exposing SQL AST internals.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct IndexAccessInput {
+    pub equality_terms: usize,
+    pub range_terms: usize,
+    pub required_order: bool,
