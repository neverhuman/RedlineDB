+/// Lock-admission facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LockAdmissionInput {
+    pub rel_id: RelId,
+    pub row_id: RowId,
+    pub requester_tx: TxId,
+    pub holder_tx: Option<TxId>,
+    pub waiter_count: usize,
+    pub timeout_ms: u64,
+}
+
+/// Lock-admission action.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum LockAdmissionAction {
+    Grant,
+    Enqueue,
+    Spin,
+    Timeout,
+}
+
+/// Lock-admission decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct LockAdmissionDecision {
+    pub action: LockAdmissionAction,
+}
+
+/// Default lock admission preserves FIFO-style queueing.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultLockAdmissionStage;
+
+impl Stage<LockAdmissionInput, LockAdmissionDecision> for DefaultLockAdmissionStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.lock_admission"),
+            kind: StageKind::LockAdmission,
+            version: 1,
+            purity: StagePurity::OrderedSideEffect,
+            deterministic: true,
+            notes: "Grants unlocked rows and queues contended rows.",
+        }
+    }
+
+    fn evaluate(&self, input: LockAdmissionInput) -> Result<LockAdmissionDecision> {
+        let action = if input.holder_tx.is_none() {
+            LockAdmissionAction::Grant
+        } else if input.timeout_ms == 0 {
+            LockAdmissionAction::Timeout
+        } else {
+            LockAdmissionAction::Enqueue
+        };
+        Ok(LockAdmissionDecision { action })
+    }
+}
