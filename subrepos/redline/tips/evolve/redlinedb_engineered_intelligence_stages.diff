+/// Recovery target envelope independent of `engine::RecoveryTarget`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum ReplayTarget {
+    Latest,
+    Lsn(Lsn),
+    Csn(Csn),
+}
+
+/// WAL recovery planning facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RecoveryReplayInput {
+    pub checkpoint_lsn: Lsn,
+    pub valid_end_lsn: Lsn,
+    pub target: ReplayTarget,
+    pub torn_tail: bool,
+    pub scanned_records: usize,
+}
+
+/// WAL recovery plan. The recovery engine still validates every record/page.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct RecoveryReplayDecision {
+    pub replay_from_lsn: Lsn,
+    pub stop_lsn: Option<Lsn>,
+    pub stop_csn: Option<Csn>,
+    pub allow_torn_tail: bool,
+}
+
+/// Default recovery planner: replay from checkpoint to the requested target.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultRecoveryReplayStage;
+
+impl Stage<RecoveryReplayInput, RecoveryReplayDecision> for DefaultRecoveryReplayStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.recovery_replay"),
+            kind: StageKind::RecoveryReplay,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Replays the checksum-valid WAL prefix from the checkpoint LSN.",
+        }
+    }
+
+    fn evaluate(&self, input: RecoveryReplayInput) -> Result<RecoveryReplayDecision> {
+        let (stop_lsn, stop_csn) = match input.target {
+            ReplayTarget::Latest => (None, None),
+            ReplayTarget::Lsn(lsn) => (Some(lsn), None),
+            ReplayTarget::Csn(csn) => (None, Some(csn)),
+        };
+        Ok(RecoveryReplayDecision {
+            replay_from_lsn: input.checkpoint_lsn,
+            stop_lsn,
+            stop_csn,
+            allow_torn_tail: input.torn_tail,
+        })
+    }
+}
