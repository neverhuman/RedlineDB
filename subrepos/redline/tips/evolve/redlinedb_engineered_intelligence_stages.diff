+            deterministic: true,
+            notes: "Preserves WAL payload order and contents.",
+        }
+    }
+
+    fn evaluate(&self, input: WalCombineInput) -> Result<WalCombineDecision> {
+        Ok(WalCombineDecision {
+            payloads: input.payloads,
+        })
