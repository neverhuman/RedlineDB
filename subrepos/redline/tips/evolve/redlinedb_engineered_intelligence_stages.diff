+/// Minimal tuple visibility facts exposed to a pure visibility stage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VisibilityInput {
+    pub reader_tx: TxId,
+    pub creator_tx: TxId,
+    pub deleter_tx: Option<TxId>,
+    pub creator_csn: Option<Csn>,
+    pub deleter_csn: Option<Csn>,
+    pub snapshot_csn: Csn,
+}
+
+/// Visibility decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VisibilityDecision {
+    pub visible: bool,
+}
+
+/// Default MVCC visibility fast path for committed creator/deleter facts.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultVisibilityStage;
+
+impl Stage<VisibilityInput, VisibilityDecision> for DefaultVisibilityStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.visibility"),
+            kind: StageKind::Visibility,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Visible to own writer or committed before snapshot and not deleted before snapshot.",
+        }
+    }
+
+    fn evaluate(&self, input: VisibilityInput) -> Result<VisibilityDecision> {
+        let creator_visible = input.creator_tx == input.reader_tx
+            || input
+                .creator_csn
+                .map(|csn| csn <= input.snapshot_csn)
+                .unwrap_or(false);
+        let deleted_visible = input
+            .deleter_csn
+            .map(|csn| csn <= input.snapshot_csn)
+            .unwrap_or(false);
+        Ok(VisibilityDecision {
+            visible: creator_visible && !deleted_visible,
+        })
+    }
+}
