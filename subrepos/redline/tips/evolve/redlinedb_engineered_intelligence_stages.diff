+/// Heap append placement facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HeapPlacementInput {
+    pub rel_id: RelId,
+    pub row_id_hint: Option<RowId>,
+    pub payload_len: usize,
+    pub lane_count: usize,
+    pub writer_id: u64,
+}
+
+/// Heap placement decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct HeapPlacementDecision {
+    pub lane: usize,
+    pub row_id_hint: Option<RowId>,
+}
+
+/// Default heap placement: writer ID modulo lane count.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultHeapPlacementStage;
+
+impl Stage<HeapPlacementInput, HeapPlacementDecision> for DefaultHeapPlacementStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.heap_placement"),
+            kind: StageKind::HeapPlacement,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Spreads writers across heap lanes by writer-id modulo lane count.",
+        }
+    }
+
+    fn evaluate(&self, input: HeapPlacementInput) -> Result<HeapPlacementDecision> {
+        let lanes = input.lane_count.max(1);
+        Ok(HeapPlacementDecision {
+            lane: (input.writer_id as usize) % lanes,
+            row_id_hint: input.row_id_hint,
+        })
+    }
+}
