+++ b/crates/kernel/src/stages/mod.rs
+//! Engineered-intelligence stage contracts.
+//!
+//! This module standardizes the narrow decision surfaces that are safe to
+//! evolve independently from the correctness-critical kernel. A stage receives
+//! an immutable input envelope and returns a bounded decision. Callers remain
+//! responsible for enforcing invariants such as commit durability, MVCC
+//! visibility, page/WAL checksums, and catalog publication order.
+//!
+//! The contracts are intentionally additive. Default stages mirror today's
+//! behavior; later patches can route existing WAL, storage, heap, index,
+//! vector, and JSON call sites through these traits one at a time.
+
+use crate::format::{Csn, Lsn, PageId, RelId, RowId, TxId};
+use crate::wal::{WalPayload, WalRecordKind};
+use crate::Result;
+
+/// Stable identifier for a stage implementation within a genome.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct StageId(pub &'static str);
+
+/// Coarse class of an engineered-intelligence stage.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StageKind {
+    WalSchedule,
+    WalCombine,
+    CommitBarrier,
+    RecoveryReplay,
+    BufferResidency,
+    CheckpointBatch,
+    Prefetch,
+    HeapPlacement,
+    Visibility,
+    LockAdmission,
+    IndexAccess,
+    IndexMutation,
+    CatalogSnapshot,
+    VectorDistance,
+    VectorTopK,
+    JsonPath,
+}
+
+/// How much side-effect authority a stage has.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum StagePurity {
+    /// Pure function: identical input should produce identical output.
+    Pure,
+    /// Advisory hint: correctness must not depend on the output.
+    Advisory,
+    /// Guarded transform: caller validates output before use.
+    GuardedTransform,
+    /// Ordered side-effect planner: returns the side effect the kernel must run.
+    OrderedSideEffect,
+}
+
+/// Metadata every stage exposes to the genome registry and audit harness.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StageDescriptor {
+    pub id: StageId,
+    pub kind: StageKind,
+    pub version: u16,
+    pub purity: StagePurity,
+    pub deterministic: bool,
+    pub notes: &'static str,
+}
+
+/// Standard stage contract. Implementations must be panic-free for all valid
+/// inputs of their stage-specific envelope.
+pub trait Stage<I, O>: Send + Sync + 'static {
+    fn descriptor(&self) -> StageDescriptor;
+    fn evaluate(&self, input: I) -> Result<O>;
+}
+
+/// WAL writer scheduling facts.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct WalScheduleInput {
+    pub pending_bytes: usize,
+    pub pending_records: usize,
+    pub flush_gap_bytes: u64,
+    pub configured_write_batch_bytes: usize,
+    pub configured_delay_us: u64,
+    pub configured_max_group_bytes: u64,
+}
+
+/// WAL writer scheduling decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct WalScheduleDecision {
+    pub write_batch_bytes: usize,
+    pub group_commit_delay_us: u64,
+    pub resample_flush_target: bool,
+    pub drain_batch_bytes: usize,
+}
+
+/// Behavior-preserving default for the current WAL scheduling policy.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultWalScheduleStage;
+
+impl Stage<WalScheduleInput, WalScheduleDecision> for DefaultWalScheduleStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.wal_schedule"),
+            kind: StageKind::WalSchedule,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Mirrors the current default WAL write-batch and group-commit scheduling.",
+        }
+    }
+
+    fn evaluate(&self, input: WalScheduleInput) -> Result<WalScheduleDecision> {
+        let write_batch_bytes = input.configured_write_batch_bytes.max(1);
+        let delay = if input.flush_gap_bytes >= input.configured_max_group_bytes {
+            0
+        } else {
+            input.configured_delay_us
+        };
+        Ok(WalScheduleDecision {
+            write_batch_bytes,
+            group_commit_delay_us: delay,
+            resample_flush_target: true,
+            drain_batch_bytes: write_batch_bytes,
+        })
+    }
+}
