+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CheckpointBatchDecision {
+    pub max_pages: usize,
+    pub sort_key: DirtySortKey,
+}
+
+/// Default checkpoint stage flushes the discovered dirty set in current order.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultCheckpointBatchStage;
+
+impl Stage<CheckpointBatchInput, CheckpointBatchDecision> for DefaultCheckpointBatchStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.checkpoint_batch"),
+            kind: StageKind::CheckpointBatch,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Flushes all discovered durable dirty pages without reordering.",
+        }
+    }
+
+    fn evaluate(&self, input: CheckpointBatchInput) -> Result<CheckpointBatchDecision> {
+        Ok(CheckpointBatchDecision {
+            max_pages: input.dirty_pages.max(1),
+            sort_key: DirtySortKey::PreserveDiscovery,
+        })
+    }
+}
