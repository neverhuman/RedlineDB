+/// Vector metric independent of the vector module's implementation details.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StageVectorMetric {
+    L2,
+    Cosine,
+    InnerProduct,
+}
+
+/// Vector distance dispatch facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VectorDistanceInput {
+    pub dimensions: usize,
+    pub metric: StageVectorMetric,
+    pub simd_available: bool,
+}
+
+/// Vector distance kernel selection.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VectorDistanceKernel {
+    Scalar,
+    Simd,
+}
+
+/// Vector distance decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VectorDistanceDecision {
+    pub kernel: VectorDistanceKernel,
+}
+
+/// Default vector distance dispatch.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultVectorDistanceStage;
+
+impl Stage<VectorDistanceInput, VectorDistanceDecision> for DefaultVectorDistanceStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.vector_distance"),
+            kind: StageKind::VectorDistance,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Uses SIMD when available for non-empty vectors, otherwise scalar.",
+        }
+    }
+
+    fn evaluate(&self, input: VectorDistanceInput) -> Result<VectorDistanceDecision> {
+        Ok(VectorDistanceDecision {
+            kernel: if input.simd_available && input.dimensions > 0 {
+                VectorDistanceKernel::Simd
+            } else {
+                VectorDistanceKernel::Scalar
+            },
+        })
+    }
+}
+
+/// Top-K vector search facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VectorTopKInput {
+    pub candidates: usize,
+    pub k: usize,
+    pub heap_budget: usize,
+}
+
+/// Top-K algorithm choice.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum VectorTopKAlgorithm {
+    FixedHeap,
+    PartialSort,
+    FullSort,
+}
+
+/// Top-K decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct VectorTopKDecision {
+    pub algorithm: VectorTopKAlgorithm,
+}
+
+/// Default top-K choice.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultVectorTopKStage;
+
+impl Stage<VectorTopKInput, VectorTopKDecision> for DefaultVectorTopKStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.vector_top_k"),
+            kind: StageKind::VectorTopK,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Uses a fixed heap when K fits the budget, partial sort otherwise, full sort for degenerate K.",
+        }
+    }
+
+    fn evaluate(&self, input: VectorTopKInput) -> Result<VectorTopKDecision> {
+        let algorithm = if input.k == 0 || input.k >= input.candidates {
+            VectorTopKAlgorithm::FullSort
+        } else if input.k <= input.heap_budget {
+            VectorTopKAlgorithm::FixedHeap
+        } else {
+            VectorTopKAlgorithm::PartialSort
+        };
+        Ok(VectorTopKDecision { algorithm })
+    }
+}
+
+/// JSON path dispatch facts.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct JsonPathInput {
+    pub document_bytes: usize,
+    pub path_bytes: usize,
+    pub repeated_extractions: usize,
+}
+
+/// JSON path dispatch mode.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum JsonPathMode {
+    Interpret,
+    CompilePath,
+    CachedPath,
+}
+
+/// JSON path decision.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct JsonPathDecision {
+    pub mode: JsonPathMode,
+}
+
+/// Default JSON path stage.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DefaultJsonPathStage;
+
+impl Stage<JsonPathInput, JsonPathDecision> for DefaultJsonPathStage {
+    fn descriptor(&self) -> StageDescriptor {
+        StageDescriptor {
+            id: StageId("kernel.default.json_path"),
+            kind: StageKind::JsonPath,
+            version: 1,
+            purity: StagePurity::Pure,
+            deterministic: true,
+            notes: "Interprets one-off paths, compiles long paths, and caches repeated paths.",
+        }
+    }
+
+    fn evaluate(&self, input: JsonPathInput) -> Result<JsonPathDecision> {
+        let mode = if input.repeated_extractions > 1 {
+            JsonPathMode::CachedPath
+        } else if input.path_bytes > 32 || input.document_bytes > 4096 {
+            JsonPathMode::CompilePath
+        } else {
+            JsonPathMode::Interpret
+        };
+        Ok(JsonPathDecision { mode })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn assert_descriptor<D, I, O>(stage: D, kind: StageKind)
+    where
+        D: Stage<I, O>,
+    {
+        let descriptor = stage.descriptor();
+        assert_eq!(descriptor.kind, kind);
+        assert_eq!(descriptor.version, 1);
+        assert!(!descriptor.id.0.is_empty());
+    }
+
+    #[test]
+    fn default_stage_descriptors_are_stable() {
+        assert_descriptor(DefaultWalScheduleStage, StageKind::WalSchedule);
+        assert_descriptor(DefaultWalCombineStage, StageKind::WalCombine);
+        assert_descriptor(DefaultCommitBarrierStage, StageKind::CommitBarrier);
+        assert_descriptor(DefaultRecoveryReplayStage, StageKind::RecoveryReplay);
+        assert_descriptor(DefaultBufferResidencyStage, StageKind::BufferResidency);
+        assert_descriptor(DefaultCheckpointBatchStage, StageKind::CheckpointBatch);
+        assert_descriptor(DefaultPrefetchStage, StageKind::Prefetch);
+        assert_descriptor(DefaultHeapPlacementStage, StageKind::HeapPlacement);
+        assert_descriptor(DefaultVisibilityStage, StageKind::Visibility);
+        assert_descriptor(DefaultLockAdmissionStage, StageKind::LockAdmission);
+        assert_descriptor(DefaultIndexAccessStage, StageKind::IndexAccess);
+        assert_descriptor(DefaultIndexMutationStage, StageKind::IndexMutation);
+        assert_descriptor(DefaultCatalogSnapshotStage, StageKind::CatalogSnapshot);
+        assert_descriptor(DefaultVectorDistanceStage, StageKind::VectorDistance);
+        assert_descriptor(DefaultVectorTopKStage, StageKind::VectorTopK);
+        assert_descriptor(DefaultJsonPathStage, StageKind::JsonPath);
+    }
+
+    #[test]
+    fn wal_schedule_default_is_bounded() {
+        let decision = DefaultWalScheduleStage
+            .evaluate(WalScheduleInput {
+                configured_write_batch_bytes: 0,
+                configured_delay_us: 200,
+                configured_max_group_bytes: 1024,
+                flush_gap_bytes: 2048,
+                ..WalScheduleInput::default()
+            })
+            .unwrap();
+
+        assert_eq!(decision.write_batch_bytes, 1);
+        assert_eq!(decision.drain_batch_bytes, 1);
+        assert_eq!(decision.group_commit_delay_us, 0);
+        assert!(decision.resample_flush_target);
+    }
+
+    #[test]
+    fn buffer_residency_default_never_evicts_pinned_or_undurable_dirty_pages() {
+        let pinned = DefaultBufferResidencyStage
+            .evaluate(BufferResidencyInput {
+                page_id: PageId(1),
+                pin_count: 1,
+                dirty: false,
+                usage_count: 0,
+                page_lsn: Lsn(1),
+                durable_lsn: Lsn(1),
+                resident_pages: 1,
+                capacity_pages: 1,
+            })
+            .unwrap();
+        assert!(!pinned.evictable);
+
+        let dirty_newer_than_durable = DefaultBufferResidencyStage
+            .evaluate(BufferResidencyInput {
+                page_id: PageId(1),
+                pin_count: 0,
+                dirty: true,
+                usage_count: 0,
+                page_lsn: Lsn(2),
+                durable_lsn: Lsn(1),
+                resident_pages: 1,
+                capacity_pages: 1,
+            })
+            .unwrap();
+        assert!(!dirty_newer_than_durable.evictable);
+    }
+
+    #[test]
+    fn commit_barrier_default_never_downgrades_strict() {
+        let decision = DefaultCommitBarrierStage
+            .evaluate(CommitBarrierInput {
+                durability: DurabilityMode::Strict,
+                end_lsn: Lsn(9),
+                written_lsn: Lsn(0),
+                durable_lsn: Lsn(0),
+            })
+            .unwrap();
+
+        assert_eq!(
+            decision.requirement,
+            CommitBarrierRequirement::FlushUntil(Lsn(9))
+        );
+    }
+
+    #[test]
+    fn placement_and_topk_defaults_clamp_degenerate_inputs() {
+        let placement = DefaultHeapPlacementStage
+            .evaluate(HeapPlacementInput {
+                rel_id: RelId(1),
+                row_id_hint: None,
+                payload_len: 8,
+                lane_count: 0,
+                writer_id: 99,
+            })
+            .unwrap();
+        assert_eq!(placement.lane, 0);
+
+        let topk = DefaultVectorTopKStage
+            .evaluate(VectorTopKInput {
+                candidates: 3,
+                k: 8,
+                heap_budget: 2,
+            })
+            .unwrap();
+        assert_eq!(topk.algorithm, VectorTopKAlgorithm::FullSort);
+    }
+}
